+    /// APAC, or the rendered feeds as linear PCM when the configuration asks for lossless output.
+    private static func makeEncoder(_ configuration: APACConfiguration) throws -> any SpatialPacketEncoder {
+        configuration.losslessPCM ? try LPCMPacketizer(layout: configuration.layout) : try APACEncoder(configuration: configuration)
+    }
+
+    /// One linear PCM packet as a sample buffer of its frames.
+    private func linearPCMBuffer(_ packet: APACEncoder.Packet, format: CMAudioFormatDescription, at time: CMTime) throws -> CMSampleBuffer {
+        var block: CMBlockBuffer?
+        try Self.check(CMBlockBufferCreateWithMemoryBlock(allocator: kCFAllocatorDefault, memoryBlock: nil,
+            blockLength: packet.data.count, blockAllocator: kCFAllocatorDefault, customBlockSource: nil, offsetToData: 0,
+            dataLength: packet.data.count, flags: kCMBlockBufferAssureMemoryNowFlag, blockBufferOut: &block))
+        guard let block else { throw SpatialAudioError.encoding("Could not allocate PCM") }
+        try packet.data.withUnsafeBytes {
+            try Self.check(CMBlockBufferReplaceDataBytes(with: $0.baseAddress!, blockBuffer: block, offsetIntoDestination: 0,
+                                                         dataLength: packet.data.count))
+        }
+        var timing = CMSampleTimingInfo(duration: CMTime(value: 1, timescale: 48_000), presentationTimeStamp: time,
+                                        decodeTimeStamp: .invalid)
+        var buffer: CMSampleBuffer?
+        try Self.check(CMSampleBufferCreateReady(allocator: kCFAllocatorDefault, dataBuffer: block, formatDescription: format,
+            sampleCount: packet.frames, sampleTimingEntryCount: 1, sampleTimingArray: &timing, sampleSizeEntryCount: 0,
+            sampleSizeArray: nil, sampleBufferOut: &buffer))
+        guard let buffer else { throw SpatialAudioError.encoding("Could not create a PCM sample buffer") }
+        return buffer
+    }
+
     /// A copy of a one-packet buffer that the renderer decodes but does not play.
