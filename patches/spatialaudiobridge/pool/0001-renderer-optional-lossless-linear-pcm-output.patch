+/// What ``SpatialAudioRenderer`` enqueues: APAC packets, or the rendered feeds as linear PCM.
+@available(macOS 26, iOS 26, tvOS 26, *)
+protocol SpatialPacketEncoder: AnyObject {
+    var format: CMAudioFormatDescription { get }
+    var primingFrames: Int { get }
+    func encode(_ samples: ArraySlice<Float>, final: Bool) throws -> [APACEncoder.Packet]
+}
+
+@available(macOS 26, iOS 26, tvOS 26, *)
+extension SpatialPacketEncoder {
+    func encode(_ samples: ArraySlice<Float>) throws -> [APACEncoder.Packet] { try encode(samples, final: false) }
+}
+
+@available(macOS 26, iOS 26, tvOS 26, *)
+extension APACEncoder: SpatialPacketEncoder {}
+
+/// The rendered speaker feeds as linear PCM: interleaved 32-bit float at 48 kHz in the layout's
+/// Atmos channel layout, cut into independent packets of 1024 frames. No priming and no delay; the
+/// final packet holds what is left. Each sample is rounded to the nearest 24-bit step (1/8388608 of
+/// full scale), so the output's conversion to the 24-bit PCM that Dolby MAT and HDMI carry is exact:
+/// what reaches the receiver is these samples bit for bit, not a second rounding of the render.
+/// A float32 holds every 24-bit value exactly; decoded 24-bit PCM is already on the grid.
+@available(macOS 26, iOS 26, tvOS 26, *)
+final class LPCMPacketizer: SpatialPacketEncoder {
+    let format: CMAudioFormatDescription
+    let primingFrames = 0
+    private let channels: Int
+    private var pending: [Float] = []
+
+    init(layout: SpatialAudioLayout) throws {
+        format = try pcmFormat(rate: 48_000, layout: layout)
+        channels = layout.channelCount
+    }
+
+    func encode(_ samples: ArraySlice<Float>, final: Bool) throws -> [APACEncoder.Packet] {
+        pending.append(contentsOf: Self.on24BitGrid(samples))
+        let step = 1024 * channels
+        var packets: [APACEncoder.Packet] = []
+        var start = 0
+        while pending.count - start >= step || (final && pending.count - start >= channels) {
+            let end = min(start + step, pending.count - (pending.count - start) % channels)
+            let data = pending[start..<end].withUnsafeBytes { Data($0) }
+            packets.append(APACEncoder.Packet(data: data, isIndependent: true, frames: (end - start) / channels))
+            start = end
+        }
+        pending.removeFirst(start)
+        return packets
+    }
+
+    /// Rounds to the nearest multiple of 2^-23, within the 24-bit range [-1, 1 - 2^-23].
+    static func on24BitGrid(_ samples: ArraySlice<Float>) -> [Float] {
+        guard !samples.isEmpty else { return [] }
+        var out = [Float](repeating: 0, count: samples.count)
+        samples.withUnsafeBufferPointer { input in
+            out.withUnsafeMutableBufferPointer { output in
+                var scale: Float = 8_388_608
+                vDSP_vsmul(input.baseAddress!, 1, &scale, output.baseAddress!, 1, vDSP_Length(input.count))
+                var count = Int32(input.count)
+                vvnintf(output.baseAddress!, output.baseAddress!, &count)
+                var low: Float = -8_388_608, high: Float = 8_388_607
+                vDSP_vclip(output.baseAddress!, 1, &low, &high, output.baseAddress!, 1, vDSP_Length(input.count))
+                var back: Float = 1 / 8_388_608
+                vDSP_vsmul(output.baseAddress!, 1, &back, output.baseAddress!, 1, vDSP_Length(input.count))
+            }
+        }
+        return out
+    }
+}
