+// --avfoundation-restart-frames (upstream 0056, ported; off by default): each
+// of the first AVF_RESTART_FRAMES timed frames after the start, a seek or a
+// resume waits for its own subtitles at least AVF_OSD_RESTART_WAIT_NS,
+// behind or not, and as long as its deadline allows while the render thread
+// is not behind, until one such wait runs out (after a seek the third and
+// fourth frames went out without theirs on Plezy's Apple TV).
+#define AVF_OSD_RESTART_WAIT_NS INT64_C(25000000)
+
+static int64_t avf_osd_restart_wait_until(int64_t now, int64_t present_ns,
+                                          int64_t queue_lead_ns, bool behind)
+{
+    int64_t until = present_ns - queue_lead_ns / 2;
+    int64_t least = now + AVF_OSD_RESTART_WAIT_NS;
+    return !behind && until > least ? until : least;
+}
