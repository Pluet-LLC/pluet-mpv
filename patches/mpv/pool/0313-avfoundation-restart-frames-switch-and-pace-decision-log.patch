+// --- avf restart stamp (host-testable; keep freestanding) ---
+// --avfoundation-restart-frames (upstream 0056, ported onto 0307): a sample
+// that reaches the layers less than about three refreshes before the refresh
+// its stamp asks for (the first link instant at or after it) can show a
+// refresh late in the video layer and not in the OSD layer (Plezy's HDMI
+// captures). For the first AVF_RESTART_FRAMES timed frames after the start, a
+// seek or a resume, a stamp whose refresh comes less than 3.5 refreshes
+// after the hand-over moves on by whole refreshes until it does not; the
+// frames after follow it (avf_host_present_ns()). 0307 holds the hand-over
+// for its pacing point, under a refresh after the stamp is made, so the
+// hand-over is taken as handover_ns = now + a refresh. A period of 0 leaves
+// the stamp as it is.
+#define AVF_RESTART_FRAMES 8
+
+static int64_t avf_host_restart_stamp_ns(int64_t stamp_ns, int64_t handover_ns,
+                                         int64_t vsync_ns, int64_t period_ns)
+{
+    if (period_ns <= 0)
+        return stamp_ns;
+    int64_t rest_ns = (stamp_ns - vsync_ns) % period_ns;
+    if (rest_ns < 0)
+        rest_ns += period_ns;
+    int64_t refresh_ns = rest_ns ? stamp_ns + period_ns - rest_ns : stamp_ns;
+    int64_t min_ns = handover_ns + period_ns * 7 / 2;
+    if (refresh_ns >= min_ns)
+        return stamp_ns;
+    return stamp_ns + (min_ns - refresh_ns + period_ns - 1) / period_ns * period_ns;
+}
