 // Present what the render thread has for this frame, waiting only as long
 // as avf_osd_wait_until allows. A result that arrives later is shown with a
 // later frame; of several ready ones only the newest is drawn.
+// The start, a seek or a resume: --avfoundation-restart-frames's window
+// opens (whatever the switch says, so turning it on mid-play acts from the
+// next one), and the time is kept for the pace log.
+static void restart_window(struct vo *vo, const char *kind)
+{
+    struct priv *p = vo->priv;
+    if (p->opts->restart_frames && p->restart_left && (p->restart_moved || p->restart_waits))
+        MP_VERBOSE(vo, "restart-frames: %d moved by %d refreshes, %d waited (%d gave up)\n",
+                   p->restart_moved, p->restart_moved_refreshes, p->restart_waits,
+                   p->restart_gave_up);
+    p->restart_left = AVF_RESTART_FRAMES;
+    p->restart_wait = true;
+    p->restart_moved = p->restart_moved_refreshes = p->restart_waits = p->restart_gave_up = 0;
+    p->last_restart_ns = mp_time_ns();
+    p->last_restart_kind = kind;
+}
+
+// A restart frame, which may have waited for its subtitles, gets its
+// refreshes back (avf_host_restart_stamp_ns()), once, after its subtitles
+// are drawn and before its samples are made; 0307's pacing then holds its
+// hand-over for the point as for any frame.
+static void restart_stamp(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    if (!p->next_restart)
+        return;
+    p->next_restart = false;
+    int64_t now = mp_time_ns(), vsync, period, nominal;
+    if (!vsync_snap_grid(p, now, &vsync, &period, &nominal))
+        return;
+    int64_t old = p->next_present_host_ns;
+    int64_t moved = avf_host_restart_stamp_ns(old, now + period, vsync, period);
+    if (moved == old)
+        return;
+    p->next_present_host_ns = moved;
+    p->last_host_present_ns = moved;
+    if (p->vsync_frame_snapped)
+        p->vsync_frame_stamp_ns += moved - old;
+    p->restart_moved++;
+    p->restart_moved_refreshes += (int)((moved - old + period / 2) / period);
+}
+
