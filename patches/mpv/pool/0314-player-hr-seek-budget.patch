From: Pluet, LLC <358065800+pluetllc@users.noreply.github.com>
Date: Mon, 23 Nov 2026 12:00:00 +0000
Subject: [PATCH] player: --hr-seek-budget

A seek command without a precision flag is exact (hr-seek) for absolute
seeks: the demuxer goes to the keyframe before the target and every frame up
to it is decoded and thrown away. In a long-GOP encode (a keyframe every
10 s) that is up to 10 s of decoding per skip, 260-720 ms on an M1 and
several times that on an Apple TV with an A10X, where the network part of a
seek on a LAN is under 30 ms. A keyframe seek alone is no answer: it lands
on the keyframe before the target, so +10 s in a 10 s GOP can land where it
started.

--hr-seek-budget=<seconds> (default 0, off: today's behaviour) bounds that
cost for seek commands (absolute and relative) that name no precision. The
seek stays exact when the keyframe before the target is within the budget
of it; otherwise it lands on the nearer of the two keyframes around the
target, counting only a keyframe no further from the target than half the
seek's distance, so a forward skip never lands behind where it started (nor
a backward one ahead of it) and never misses by more than half the skip.
If neither keyframe qualifies, or neither is known, the seek is exact.
+exact and +keyframes seeks, and every seek the player makes itself
(--start, chapters, A-B loops, revert-seek, frame steps), are untouched:
cmd_seek alone sets MPSEEK_FLAG_BUDGET. The decided seek is then carried
out as an ordinary exact or keyframe seek (SEEK_FORWARD for the keyframe
after), so nothing new happens downstream.

The keyframes come from demux_get_keyframes_around(): the packet cache where
it holds the target (what an in-cache seek lands on), else an index the
demuxer published with demux_set_keyframe_index(): Matroska's Cues once they
are complete (read on opening, or at the first seek when 0240 defers them),
and libavformat's keyframe index entries after opening (an MP4's sample
table), except where it rewrites timestamps while reading. demux_mkv and
demux_lavf call it from their own thread with in->lock not held; the index
is kept per demux_stream under in->lock.

scripts/test_hr_seek_budget.sh compiles hr_seek_budget_applies(),
hr_seek_budget_landing() and kf_index_around() against fakes: within the
budget exact; beyond it the nearer keyframe; never behind the start of a
forward skip (a sweep over GOPs of 0.5-24 s, skips of 5-900 s either way
and budgets of 0.25-5 s); +exact, +keyframes and the player's own seeks
untouched; budget 0 decides nothing; and the option's table entry, the seek
command's flag and the gate in mp_seek().


diff --git a/DOCS/man/options.rst b/DOCS/man/options.rst
index e9b2ece..f7b2a19 100644
--- a/DOCS/man/options.rst
+++ b/DOCS/man/options.rst
@@ -432,6 +432,28 @@ Playback Control
 
     Default: ``yes``
 
+``--hr-seek-budget=<seconds>``
+    How much decoding a ``seek`` command without a precision flag may cost to
+    land exactly (Pluet). When set, such a seek (absolute or relative,
+    whatever ``--hr-seek`` says) is exact if the keyframe before the target is
+    at most this many seconds before it. Otherwise it lands on the nearer of
+    the two keyframes around the target, counting only a keyframe that is no
+    further from the target than half the distance from the position the
+    seek started at: a forward seek never lands behind where it started, a
+    backward one never ahead of it. If neither keyframe qualifies, or they
+    are not known, the seek is exact.
+
+    Keyframes are known from the demuxer cache where it holds the target,
+    else from the file's own index (Matroska Cues once read, which is at the
+    first seek outside the cache; libavformat's index, e.g. an MP4's sample
+    table).
+
+    ``+exact`` and ``+keyframes`` seeks, and seeks the player makes itself
+    (``--start``, chapters, A-B loops, ``revert-seek``, frame steps), are not
+    affected. Not used in backward playback or without video.
+
+    Default: 0 (off: seeks behave as ``--hr-seek`` says).
+
 ``--index=<mode>``
     Controls how to seek in files. Note that if the index is missing from a
     file, it will be built on the fly by default, so you don't need to change
diff --git a/demux/demux.c b/demux/demux.c
index 834c40c..0d40edf 100644
--- a/demux/demux.c
+++ b/demux/demux.c
@@ -468,6 +468,11 @@ struct demux_stream {
     // for closed captions (demuxer_feed_caption)
     struct sh_stream *cc;
     bool ignore_eof;        // ignore stream in underrun detection
+
+    // Pluet: keyframe times from the demuxer's own index (the demuxer's
+    // timestamps, ascending), see demux_set_keyframe_index().
+    double *kf_index;
+    int num_kf_index;
 };
 
 static void switch_to_fresh_cache_range(struct demux_internal *in);
@@ -980,6 +985,114 @@ void demux_set_ts_offset(struct demuxer *demuxer, double offset)
     mp_mutex_unlock(&in->lock);
 }
 
+static int compare_kf_time(const void *a, const void *b)
+{
+    double x = *(const double *)a, y = *(const double *)b;
+    return x < y ? -1 : x > y ? 1 : 0;
+}
+
+// Pluet: publish the keyframe times the demuxer's own index holds for sh
+// (seconds, in the demuxer's timestamps, any order), replacing any published
+// before. demux_get_keyframes_around() falls back on them where the packet
+// cache does not reach. Called by demuxer implementations.
+void demux_set_keyframe_index(struct demuxer *demuxer, struct sh_stream *sh,
+                              const double *pts, int num)
+{
+    struct demux_internal *in = demuxer->in;
+    mp_assert(demuxer == in->d_thread);
+
+    double *index = NULL;
+    int num_index = 0;
+    for (int n = 0; n < num; n++) {
+        if (pts[n] != MP_NOPTS_VALUE && isfinite(pts[n]))
+            MP_TARRAY_APPEND(NULL, index, num_index, pts[n]);
+    }
+    if (num_index)
+        qsort(index, num_index, sizeof(index[0]), compare_kf_time);
+
+    mp_mutex_lock(&in->lock);
+    struct demux_stream *ds = sh->ds;
+    talloc_free(ds->kf_index);
+    ds->kf_index = index ? talloc_steal(ds, index) : NULL;
+    ds->num_kf_index = num_index;
+    mp_mutex_unlock(&in->lock);
+
+    MP_VERBOSE(in, "stream %d: %d keyframes in the index\n", sh->index,
+               num_index);
+}
+
+// The last entry <= pts and the first >= pts of an ascending list, where the
+// out values are still MP_NOPTS_VALUE.
+static void kf_index_around(const double *index, int num, double pts,
+                            double *before, double *after)
+{
+    int lo = 0, hi = num; // lo: the first entry > pts
+    while (lo < hi) {
+        int mid = lo + (hi - lo) / 2;
+        if (index[mid] <= pts) {
+            lo = mid + 1;
+        } else {
+            hi = mid;
+        }
+    }
+    if (*before == MP_NOPTS_VALUE && lo > 0)
+        *before = index[lo - 1];
+    int first = lo > 0 && index[lo - 1] == pts ? lo - 1 : lo;
+    if (*after == MP_NOPTS_VALUE && first < num)
+        *after = index[first];
+}
+
+// Pluet: the keyframes of the selected video stream on either side of pts
+// (the player's timestamps): *before <= pts <= *after, MP_NOPTS_VALUE where
+// not known. From the packet cache where it holds pts (what an in-cache seek
+// lands on), else from the index the demuxer published.
+void demux_get_keyframes_around(struct demuxer *demuxer, double pts,
+                                double *before, double *after)
+{
+    struct demux_internal *in = demuxer->in;
+    mp_assert(demuxer == in->d_user);
+
+    *before = *after = MP_NOPTS_VALUE;
+    if (pts == MP_NOPTS_VALUE)
+        return;
+
+    mp_mutex_lock(&in->lock);
+    double raw = MP_ADD_PTS(pts, -in->ts_offset);
+    for (int n = 0; n < in->num_streams; n++) {
+        struct demux_stream *ds = in->streams[n]->ds;
+        if (!ds->selected || ds->type != STREAM_VIDEO ||
+            ds->sh->attached_picture || ds->sh->image)
+            continue;
+
+        for (int r = 0; r < in->num_ranges; r++) {
+            struct demux_cached_range *range = in->ranges[r];
+            if (range->seek_start == MP_NOPTS_VALUE ||
+                raw < range->seek_start || raw > range->seek_end)
+                continue;
+            struct demux_queue *queue = range->streams[ds->index];
+            double t = MP_NOPTS_VALUE;
+            struct demux_packet *kf = find_seek_target(queue, raw, 0);
+            if (kf)
+                compute_keyframe_times(kf, &t, NULL);
+            if (t != MP_NOPTS_VALUE && t <= raw)
+                *before = t;
+            t = MP_NOPTS_VALUE;
+            kf = find_seek_target(queue, raw, SEEK_FORWARD);
+            if (kf)
+                compute_keyframe_times(kf, &t, NULL);
+            if (t != MP_NOPTS_VALUE && t >= raw)
+                *after = t;
+            break;
+        }
+
+        kf_index_around(ds->kf_index, ds->num_kf_index, raw, before, after);
+        break;
+    }
+    *before = MP_ADD_PTS(*before, in->ts_offset);
+    *after = MP_ADD_PTS(*after, in->ts_offset);
+    mp_mutex_unlock(&in->lock);
+}
+
 static void add_missing_streams(struct demux_internal *in,
                                 struct demux_cached_range *range)
 {
