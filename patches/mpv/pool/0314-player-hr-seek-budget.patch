 }
 
+// Pluet: the keyframe entries libavformat's index holds for each video stream
+// after opening (an MP4's sample table, for one), for --hr-seek-budget
+// (demux_get_keyframes_around()).
+static void publish_keyframe_index(demuxer_t *demuxer)
+{
+    lavf_priv_t *priv = demuxer->priv;
+    AVFormatContext *avfc = priv->avfc;
+
+    // Timestamps the demuxer rewrites as it reads are not the index's.
+    if (priv->linearize_ts || demuxer->ts_resets_possible)
+        return;
+
+    for (int n = 0; n < priv->num_streams; n++) {
+        struct sh_stream *sh = priv->streams[n]->sh;
+        if (!sh || sh->type != STREAM_VIDEO || sh->attached_picture ||
+            n >= (int)avfc->nb_streams)
+            continue;
+        AVStream *st = avfc->streams[n];
+        int count = avformat_index_get_entries_count(st);
+        double *pts = NULL;
+        int num = 0;
+        for (int i = 0; i < count; i++) {
+            const AVIndexEntry *e = avformat_index_get_entry(st, i);
+            if (e && (e->flags & AVINDEX_KEYFRAME) &&
+                e->timestamp != AV_NOPTS_VALUE)
+                MP_TARRAY_APPEND(NULL, pts, num,
+                                 mp_pts_from_av(e->timestamp, &st->time_base));
+        }
+        if (num)
+            demux_set_keyframe_index(demuxer, sh, pts, num);
+        talloc_free(pts);
+    }
+}
+
 static int demux_open_lavf(demuxer_t *demuxer, enum demux_check check)
 {
     AVFormatContext *avfc = NULL;
@@ -1741,6 +1775,8 @@ static int demux_open_lavf(demuxer_t *demuxer, enum demux_check check)
         priv->stream = NULL;
     }
 
+    publish_keyframe_index(demuxer);
+
     if (priv->stream) {
         const char *sname = priv->stream->info->name;
         priv->is_dvd = strcmp(sname, "dvdnav") == 0 ||
diff --git a/demux/demux_mkv.c b/demux/demux_mkv.c
index e30b310..b0aa1a6 100644
--- a/demux/demux_mkv.c
+++ b/demux/demux_mkv.c
@@ -1092,6 +1092,34 @@ static void add_block_position(demuxer_t *demuxer, struct mkv_track *track,
     track->last_index_entry = mkv_d->num_indexes - 1;
 }
 
+// Pluet: the Cues' times of each video track, for --hr-seek-budget
+// (demux_get_keyframes_around()). Nothing until the index is complete.
+static void publish_keyframe_index(demuxer_t *demuxer)
+{
+    mkv_demuxer_t *mkv_d = (mkv_demuxer_t *) demuxer->priv;
+
+    if (!mkv_d->index_complete)
+        return;
+
+    for (int n = 0; n < mkv_d->num_tracks; n++) {
+        struct mkv_track *track = mkv_d->tracks[n];
+        if (track->type != MATROSKA_TRACK_VIDEO || !track->stream)
+            continue;
+        double *pts = NULL;
+        int num = 0;
+        for (size_t i = 0; i < mkv_d->num_indexes; i++) {
+            mkv_index_t *index = &mkv_d->indexes[i];
+            if (index->tnum == track->tnum) {
+                double t = (double)index->timecode * mkv_d->tc_scale / 1e9 -
+                           track->codec_delay;
+                MP_TARRAY_APPEND(NULL, pts, num, t);
+            }
+        }
+        demux_set_keyframe_index(demuxer, track->stream, pts, num);
+        talloc_free(pts);
+    }
+}
+
 static int demux_mkv_read_cues(demuxer_t *demuxer)
 {
     mkv_demuxer_t *mkv_d = (mkv_demuxer_t *) demuxer->priv;
@@ -1145,6 +1173,7 @@ static int demux_mkv_read_cues(demuxer_t *demuxer)
 
     // Do not attempt to create index on the fly.
     mkv_d->index_complete = true;
+    publish_keyframe_index(demuxer);
 
 done:
     if (!mkv_d->index_complete)
@@ -2800,6 +2829,7 @@ static int demux_mkv_open(demuxer_t *demuxer, enum demux_check check)
     MP_VERBOSE(demuxer, "All headers are parsed!\n");
 
     display_create_tracks(demuxer);
+    publish_keyframe_index(demuxer);
     pair_dovi_tracks(demuxer);
     add_coverart(demuxer);
     process_tags(demuxer);
