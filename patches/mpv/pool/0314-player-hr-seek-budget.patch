diff --git a/demux/demux_lavf.c b/demux/demux_lavf.c
index c3eab0f..2fc70c3 100644
--- a/demux/demux_lavf.c
+++ b/demux/demux_lavf.c
@@ -1468,6 +1468,40 @@ static void detect_dovi_split_streams(demuxer_t *demuxer)
