diff --git a/player/playloop.c b/player/playloop.c
index 346e251..32230c1 100644
--- a/player/playloop.c
+++ b/player/playloop.c
@@ -300,6 +300,57 @@ static double calculate_framestep_pts(MPContext *mpctx, double current_time,
     return current_time + pts;
 }
 
+// Pluet: --hr-seek-budget. Where a seek lands when the budget decides it.
+enum hr_seek_budget_landing {
+    HR_SEEK_BUDGET_EXACT,   // on the target, decoding from the keyframe before
+    HR_SEEK_BUDGET_BEFORE,  // on the keyframe at or before the target
+    HR_SEEK_BUDGET_AFTER,   // on the keyframe at or after the target
+};
+
+// Whether --hr-seek-budget decides this seek: a seek command (absolute or
+// relative) that names no precision. +exact, +keyframes and every seek the
+// player makes itself (--start, chapters, A-B loops, revert-seek, frame
+// steps) are left as they are.
+static bool hr_seek_budget_applies(double budget, const struct seek_params *seek)
+{
+    return budget > 0 && (seek->flags & MPSEEK_FLAG_BUDGET) &&
+           seek->exact == MPSEEK_DEFAULT &&
+           (seek->type == MPSEEK_ABSOLUTE || seek->type == MPSEEK_RELATIVE);
+}
+
+// target: where the seek asks for; from: the position it starts from;
+// before/after: the keyframes either side of target (MP_NOPTS_VALUE where not
+// known). Exact when the keyframe before is within the budget of the target
+// (the decoding that costs is what the budget allows), or when nothing is
+// known. Otherwise the nearer of the two keyframes, of those no further from
+// the target than half the seek's distance, so a landing is never on the
+// wrong side of where the seek started from (a forward skip never goes back,
+// a backward one never forward) and never misses by more than half the skip.
+// Exact again if neither keyframe qualifies.
+static enum hr_seek_budget_landing hr_seek_budget_landing(double target,
+                                                         double from,
+                                                         double budget,
+                                                         double before,
+                                                         double after)
+{
+    if (before == MP_NOPTS_VALUE || before > target)
+        return HR_SEEK_BUDGET_EXACT;
+    if (target - before <= budget)
+        return HR_SEEK_BUDGET_EXACT;
+    double room = fabs(target - from) / 2;
+    bool use_before = target - before <= room;
+    bool use_after = after != MP_NOPTS_VALUE && after >= target &&
+                     after - target <= room;
+    if (use_before && use_after)
+        return after - target < target - before ? HR_SEEK_BUDGET_AFTER
+                                                : HR_SEEK_BUDGET_BEFORE;
+    if (use_before)
+        return HR_SEEK_BUDGET_BEFORE;
+    if (use_after)
+        return HR_SEEK_BUDGET_AFTER;
+    return HR_SEEK_BUDGET_EXACT;
+}
+
 static void mp_seek(MPContext *mpctx, struct seek_params seek)
 {
     struct MPOpts *opts = mpctx->opts;
@@ -342,8 +393,40 @@ static void mp_seek(MPContext *mpctx, struct seek_params seek)
     default: MP_ASSERT_UNREACHABLE();
     }
 
+    // Pluet: --hr-seek-budget turns the seek into an exact one or a keyframe
+    // one, which the code below then carries out as it would have been asked.
+    int budget_dir = 0;
+    if (hr_seek_budget_applies(opts->hr_seek_budget, &seek) &&
+        seek_pts != MP_NOPTS_VALUE && opts->play_dir > 0 &&
+        mpctx->vo_chain && !mpctx->vo_chain->is_sparse)
+    {
+        double before, after;
+        demux_get_keyframes_around(mpctx->demuxer, seek_pts, &before, &after);
+        enum hr_seek_budget_landing landing =
+            hr_seek_budget_landing(seek_pts, current_time, opts->hr_seek_budget,
+                                   before, after);
+        static const char *const names[] = {
+            [HR_SEEK_BUDGET_EXACT] = "exact",
+            [HR_SEEK_BUDGET_BEFORE] = "keyframe before",
+            [HR_SEEK_BUDGET_AFTER] = "keyframe after",
+        };
+        MP_VERBOSE(mpctx, "hr-seek budget %.3f: from %f to %f, keyframes "
+                   "%f / %f: %s\n", opts->hr_seek_budget, current_time,
+                   seek_pts, before, after, names[landing]);
+        if (landing == HR_SEEK_BUDGET_EXACT) {
+            seek.exact = MPSEEK_EXACT;
+        } else {
+            seek.exact = MPSEEK_KEYFRAME;
+            budget_dir = landing == HR_SEEK_BUDGET_AFTER ? 1 : -1;
+        }
+    }
+
     double demux_pts = seek_pts;
 
+    if (budget_dir)
+        demux_flags = (demux_flags & ~SEEK_FORWARD) |
+                      (budget_dir > 0 ? SEEK_FORWARD : 0);
+
     bool hr_seek = seek.exact != MPSEEK_KEYFRAME && seek_pts != MP_NOPTS_VALUE &&
         (seek.exact >= MPSEEK_EXACT || opts->hr_seek == 1 ||
          (opts->hr_seek >= 0 && seek.type == MPSEEK_ABSOLUTE) ||
