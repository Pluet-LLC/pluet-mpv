 static const char *bd_event_str(uint32_t event)
 {
 #if BLURAY_VERSION >= BLURAY_VERSION_CODE(1, 3, 0)
@@ -1448,6 +1464,19 @@ static bool select_initial_title(stream_t *s, int title_guess) {
     return true;
 }
 
+// libbluray's block reader for an image read through an mpv stream: the
+// number of whole 2048-byte blocks read, or -1.
+static int bd_image_read_blocks(void *handle, void *buf, int lba, int num_blocks)
+{
+    struct stream *image = handle;
+    if (lba < 0 || num_blocks <= 0)
+        return -1;
+    if (!stream_seek(image, (int64_t)lba * 2048))
+        return -1;
+    int got = stream_read(image, buf, num_blocks * 2048);
+    return got < 0 ? -1 : got / 2048;
+}
+
 static int bluray_stream_open_internal(stream_t *s)
 {
     struct bluray_priv_s *b = s->priv;
@@ -1524,13 +1553,20 @@ static int bluray_stream_open_internal(stream_t *s)
 #endif
     }
 
-    char *device_tmp = mp_get_user_path(NULL, s->global, device);
-    char *keyfile = NULL;
-    if (b->opts->keyfile && b->opts->keyfile[0])
-        keyfile = mp_get_user_path(NULL, s->global, b->opts->keyfile);
-    int opened = bd_open_disc(bd, device_tmp, keyfile);
-    talloc_free(keyfile);
-    talloc_free(device_tmp);
+    int opened;
+    if (b->image) {
+        // The image's 2048-byte sectors through the stream: libbluray reads
+        // the UDF file system itself, so nothing but random access is needed.
+        opened = bd_open_stream(bd, b->image, bd_image_read_blocks);
+    } else {
+        char *device_tmp = mp_get_user_path(NULL, s->global, device);
+        char *keyfile = NULL;
+        if (b->opts->keyfile && b->opts->keyfile[0])
+            keyfile = mp_get_user_path(NULL, s->global, b->opts->keyfile);
+        opened = bd_open_disc(bd, device_tmp, keyfile);
+        talloc_free(keyfile);
+        talloc_free(device_tmp);
+    }
     if (!opened) {
         if (!b->probing)
             MP_ERR(s, "Couldn't open Blu-ray device: %s\n", device);
@@ -1740,6 +1776,30 @@ const stream_info_t stream_info_bluray = {
     .stream_origin = STREAM_ORIGIN_UNSAFE,
 };
 
+int mp_bluray_open_image(stream_t *s, struct stream *image)
+{
+    struct bluray_priv_s *b = talloc_zero(s, struct bluray_priv_s);
+    s->priv = b;
+    struct MPOpts *opts = mp_get_config_group(NULL, s->global, &mp_opt_root);
+    b->cfg_title = opts->edition_id >= 0 ? opts->edition_id
+                 : opts->disc_menu ? BLURAY_MENU_TITLE : BLURAY_DEFAULT_TITLE;
+    talloc_free(opts);
+    b->cfg_device = talloc_strdup(b, image->url);
+    b->image = image;
+    b->probing = true;
+    int r = bluray_stream_open_internal(s);
+    if (r != STREAM_OK) {
+        // The caller keeps the image (it may be a DVD).
+        b->image = NULL;
+        talloc_free(b);
+        s->priv = NULL;
+        return r;
+    }
+    b->probing = false;
+    s->close = bluray_stream_close_image;
+    return r;
+}
