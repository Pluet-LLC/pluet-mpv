+#pragma once
+
+struct stream;
+
+// Open `s` as the disc in `image`, a stream holding a Blu-ray or DVD disc
+// image (.iso) that need not be a local file: an http(s) address works,
+// as libbluray and libdvdread are given its sectors through the stream.
+// The main title plays unless --edition says otherwise; the other titles
+// are editions. On success `s` owns `image`; otherwise the caller keeps it
+// and `s->priv` is NULL. STREAM_UNSUPPORTED: not that kind of disc.
+int mp_bluray_open_image(struct stream *s, struct stream *image);
+int mp_dvdnav_open_image(struct stream *s, struct stream *image);
