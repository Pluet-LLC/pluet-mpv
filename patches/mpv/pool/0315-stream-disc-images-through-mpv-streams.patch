+static void bluray_stream_close_image(stream_t *s)
+{
+    struct bluray_priv_s *priv = s->priv;
+    bluray_stream_close(s);
+    if (priv && priv->image) {
+        free_stream(priv->image);
+        priv->image = NULL;
+    }
