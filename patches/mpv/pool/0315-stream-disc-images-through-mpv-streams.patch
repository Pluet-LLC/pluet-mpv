+// libdvdread's reader for an image read through an mpv stream. Seek: 0 or
+// -1; reads: bytes read, or -1.
+static int image_seek(void *p, uint64_t pos)
+{
+    struct priv *priv = p;
+    return stream_seek(priv->image, pos) ? 0 : -1;
+}
+
+static int image_read(void *p, void *buf, int len)
+{
+    struct priv *priv = p;
+    return stream_read(priv->image, buf, len);
+}
+
+static int image_readv(void *p, void *iovec, int blocks)
+{
+    struct priv *priv = p;
+    struct iovec *iov = iovec;
+    int total = 0;
+    for (int n = 0; n < blocks; n++) {
+        int got = stream_read(priv->image, iov[n].iov_base, iov[n].iov_len);
+        if (got < 0)
+            return -1;
+        total += got;
+        if (got < (int)iov[n].iov_len)
+            break;
+    }
+    return total;
+}
+
 static dvdnav_status_t nav_open(stream_t *stream, dvdnav_t **dest, const char *path)
 {
     struct priv *priv = stream->priv;
     priv->lib_log = mp_log_new(stream, stream->log, "/libdvdnav");
     const dvdnav_logger_cb logger_cb = { .pf_log = dvdnav_log };
+    if (priv->image) {
+        static dvdnav_stream_cb image_cb = {
+            .pf_seek = image_seek,
+            .pf_read = image_read,
+            .pf_readv = image_readv,
+        };
+        return dvdnav_open_stream2(dest, priv, &logger_cb, &image_cb);
+    }
     return dvdnav_open2(dest, priv, &logger_cb, path);
 }
 
@@ -1518,7 +1561,7 @@ static struct priv *new_dvdnav_stream(stream_t *stream, char *filename)
     if (!(priv->filename = mp_get_user_path(priv, stream->global, filename)))
         return NULL;
 
-    priv->dvd_speed = priv->opts->speed;
+    priv->dvd_speed = priv->image ? 0 : priv->opts->speed;
     dvd_set_speed(stream, priv->filename, priv->dvd_speed);
 
     if (nav_open(stream, &priv->dvdnav, priv->filename) != DVDNAV_STATUS_OK)
@@ -1692,6 +1735,39 @@ const stream_info_t stream_info_dvdnav = {
     .stream_origin = STREAM_ORIGIN_UNSAFE,
 };
 
+static void stream_dvdnav_close_image(stream_t *s)
+{
+    struct priv *priv = s->priv;
+    stream_dvdnav_close(s);
+    if (priv->image) {
+        free_stream(priv->image);
+        priv->image = NULL;
+    }
+}
+
+int mp_dvdnav_open_image(stream_t *stream, struct stream *image)
+{
+    struct priv *priv = talloc_zero(stream, struct priv);
+    stream->priv = priv;
+    struct MPOpts *opts = mp_get_config_group(NULL, stream->global, &mp_opt_root);
+    priv->track = opts->edition_id >= 0 ? opts->edition_id :
+                  (opts->disc_menu ? TITLE_MENU : TITLE_LONGEST);
+    talloc_free(opts);
+    priv->device = talloc_strdup(priv, image->url);
+    priv->image = image;
+    priv->probing = true;
+    int r = open_s_internal(stream);
+    if (r != STREAM_OK) {
+        // The caller keeps the image.
+        priv->image = NULL;
+        talloc_free(priv);
+        stream->priv = NULL;
+        return r;
+    }
+    stream->close = stream_dvdnav_close_image;
+    return r;
+}
+
