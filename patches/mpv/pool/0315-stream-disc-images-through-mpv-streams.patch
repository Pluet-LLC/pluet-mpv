+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+// disc://<address>: a Blu-ray or DVD image (.iso) read through mpv's own
+// streams, so an image a media server sends over http(s) plays as a disc:
+// main title, its chapters, the other titles as editions. Tried as a
+// Blu-ray first, then as a DVD.
+
+#include "config.h"
+
+#include "common/msg.h"
+#include "disc_image.h"
+#include "stream.h"
+
+static int disc_image_open(stream_t *s)
+{
+    const char *url = s->path;
+    if (!url || !url[0]) {
+        MP_ERR(s, "disc:// needs the address of a disc image.\n");
+        return STREAM_ERROR;
+    }
+
+    int flags = STREAM_READ | (s->stream_origin & STREAM_ORIGIN_MASK);
+    struct stream *image = stream_create(url, flags, s->cancel, s->global);
+    if (!image) {
+        MP_ERR(s, "Couldn't open the disc image %s\n", url);
+        return STREAM_ERROR;
+    }
+    if (image->seekable == false) {
+        MP_ERR(s, "The disc image can't be read out of order: %s\n", url);
+        free_stream(image);
+        return STREAM_ERROR;
+    }
+
+#if HAVE_LIBBLURAY
+    if (mp_bluray_open_image(s, image) == STREAM_OK) {
+        MP_INFO(s, "Blu-ray disc image.\n");
+        return STREAM_OK;
+    }
+#endif
+#if HAVE_DVDNAV
+    if (mp_dvdnav_open_image(s, image) == STREAM_OK) {
+        MP_INFO(s, "DVD disc image.\n");
+        return STREAM_OK;
+    }
+#endif
+
+    MP_ERR(s, "Not a Blu-ray or DVD disc image this player can play: %s\n", url);
+    free_stream(image);
+    return STREAM_UNSUPPORTED;
+}
+
+const stream_info_t stream_info_disc_image = {
+    .name = "disc_image",
+    .open = disc_image_open,
+    .protocols = (const char*const[]){ "disc", NULL },
+    .stream_origin = STREAM_ORIGIN_UNSAFE,
+};
