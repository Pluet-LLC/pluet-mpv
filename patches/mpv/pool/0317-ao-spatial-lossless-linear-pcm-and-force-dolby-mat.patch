+/// MP_SPATIAL_*: the stream itself (not Atmos or DTS:X, malformed) fails as
+/// before; with linear PCM, anything else is the renderer turning it down.
+@available(macOS 26, iOS 26, tvOS 26, *)
+func mpSpatialFailureKind(_ failure: (any Error)?, lossless: Bool) -> Int32 {
+    guard let failure else { return 0 } // MP_SPATIAL_OK
+    switch failure as? SpatialAudioError {
+    case .discontinuity?: return 1 // MP_SPATIAL_DISCONTINUITY
+    case .unsupported?, .decoding?: return 2 // MP_SPATIAL_FAILED
+    default: return lossless ? 3 : 2 // MP_SPATIAL_OUTPUT_FAILED, MP_SPATIAL_FAILED
+    }
+}
