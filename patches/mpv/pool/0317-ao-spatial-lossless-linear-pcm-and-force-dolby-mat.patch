+// Apple's Atmos 7.1.4 order (kAudioChannelLayoutTag_Atmos_7_1_4: L R C LFE
+// Ls Rs Rls Rrs Vhl Vhr Ltr Rtr) in mpv's speakers.
+static const int atmos_speakers[12] = {
+    MP_SPEAKER_ID_FL, MP_SPEAKER_ID_FR, MP_SPEAKER_ID_FC, MP_SPEAKER_ID_LFE,
+    MP_SPEAKER_ID_SL, MP_SPEAKER_ID_SR, MP_SPEAKER_ID_BL, MP_SPEAKER_ID_BR,
+    MP_SPEAKER_ID_TFL, MP_SPEAKER_ID_TFR, MP_SPEAKER_ID_TBL, MP_SPEAKER_ID_TBR,
+};
+
+// Each channel's place in the 7.1.4 layout. A layout with back but no side
+// surrounds (mpv's "5.1") is a 5.1 whose surrounds sit at the side, as Apple's
+// 5.1 has them.
+static void atmos_slots(const struct mp_chmap *map, int8_t *slots)
+{
+    bool sides = false, backs = false;
+    for (int i = 0; i < map->num; i++) {
+        sides |= map->speaker[i] == MP_SPEAKER_ID_SL || map->speaker[i] == MP_SPEAKER_ID_SR;
+        backs |= map->speaker[i] == MP_SPEAKER_ID_BL || map->speaker[i] == MP_SPEAKER_ID_BR;
+    }
+    for (int i = 0; i < map->num; i++) {
+        slots[i] = -1;
+        for (int n = 0; n < 12; n++) {
+            if (map->speaker[i] == atmos_speakers[n])
+                slots[i] = n;
+        }
+        if (backs && !sides && (slots[i] == 6 || slots[i] == 7))
+            slots[i] -= 2;
+    }
+}
+
+// Whether the rendered 7.1.4 goes out as linear PCM: asked for, or on auto
+// where the sound goes over HDMI. Not after the renderer turned it down here.
+static bool use_lpcm(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    if (p->opt_output == SPATIAL_OUTPUT_APAC)
+        return false;
+    if (atomic_load(&ao->global->spatial_lpcm_failed)) {
+        MP_VERBOSE(ao, "linear PCM failed on this player; APAC\n");
+        return false;
+    }
+    if (p->opt_output == SPATIAL_OUTPUT_LPCM)
+        return true;
+#if TARGET_OS_IPHONE
+    AVAudioSessionPortDescription *port =
+        AVAudioSession.sharedInstance.currentRoute.outputs.firstObject;
+    MP_VERBOSE(ao, "route: %s\n", port ? port.portType.UTF8String : "none");
+    return [port.portType isEqualToString:AVAudioSessionPortHDMI];
+#else
+    return false;
+#endif
+}
