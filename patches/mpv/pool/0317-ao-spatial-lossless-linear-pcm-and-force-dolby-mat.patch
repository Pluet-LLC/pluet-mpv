+@_cdecl("mp_spatial_create_pcm")
+func mpSpatialCreatePCM(_ slots: UnsafePointer<Int8>, _ channels: Int32, _ pointer: UnsafeMutableRawPointer,
+                        _ bufferLimit: Int) -> UnsafeMutableRawPointer? {
+    guard #available(macOS 26, iOS 26, tvOS 26, *), channels > 0 else { return nil }
+    let synchronizer = Unmanaged<AVSampleBufferRenderSynchronizer>.fromOpaque(pointer).takeUnretainedValue()
+    let map = (0..<Int(channels)).map { Int(slots[$0]) }
+    do {
+        return Unmanaged.passRetained(try SpatialOutput(slots: map, synchronizer: synchronizer,
+                                                        bufferLimit: bufferLimit)).toOpaque()
+    } catch {
+        NSLog("[ao_spatial] Cannot open the PCM output: %@", String(describing: error))
+        return nil
+    }
+}
+
+/// Decoded PCM for the lossless renderer: interleaved 32-bit float frames of
+/// `slots.count` channels, each written to its 7.1.4 slot (the rest silent),
+/// unchanged. Bytes may arrive split anywhere.
+@available(macOS 26, iOS 26, tvOS 26, *)
+final class PCMSlotDecoder: SpatialAudioRendererDecoding {
+    private let slots: [Int]
+    private var pending: [UInt8] = []
+
+    init(slots: [Int]) { self.slots = slots }
+
+    func decode(_ bytes: UnsafeRawBufferPointer, end: Bool) throws -> [PCMBlock] {
+        pending.append(contentsOf: bytes)
+        let stride = slots.count * 4
+        let frames = pending.count / stride
+        defer { if end { pending.removeAll() } }
+        guard frames > 0 else { return [] }
+        var samples = [Float](repeating: 0, count: frames * 12)
+        pending.withUnsafeBytes { input in
+            samples.withUnsafeMutableBufferPointer { output in
+                for frame in 0..<frames {
+                    for (channel, slot) in slots.enumerated() where (0..<12).contains(slot) {
+                        output[frame * 12 + slot] = input.loadUnaligned(fromByteOffset: frame * stride + channel * 4,
+                                                                         as: Float.self)
+                    }
+                }
+            }
+        }
+        pending.removeFirst(frames * stride)
+        return [PCMBlock(samples: samples, frames: frames, sampleRate: 48_000, channels: 12)]
+    }
+}
