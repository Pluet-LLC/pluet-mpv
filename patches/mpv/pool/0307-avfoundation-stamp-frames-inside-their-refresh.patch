+        static const char *const modes[] = {"off", "on", "measure"};
+        double per = MPMAX(st->period_ns, 1);
+        // Three lines, each short enough for a host that keeps 200 characters.
+        MP_VERBOSE(vo, "vsync-snap %s: %d frames/%.1fs (%d no refresh), refresh "
+                   "%.3f ms (link %.3f), lock %+.2f ms, layer %+.3f ms, moved=%d, "
+                   "shift avg %+.2f max %.2f ms, relocks=%d reslots=%d\n",
+                   modes[p->opts->vsync_snap], st->frames,
+                   (now - st->window_start_ns) / 1e9, st->unsnapped,
+                   st->period_ns / 1e6, st->nominal_ns / 1e6,
+                   -p->vsync_snap.lock_ns / 1e6, p->vsync_tb_offset_ns / 1e6,
+                   st->moved, st->shift_sum / n / 1e6, st->shift_max / 1e6,
+                   p->vsync_snap.relocks - st->relocks0,
+                   p->vsync_snap.reslots - st->reslots0);
