index 2b644cd..0d332af 100644
--- a/video/out/vo_avfoundation.m
+++ b/video/out/vo_avfoundation.m
@@ -269,6 +269,29 @@ static bool avf_shader_target(int frame_w, int frame_h, int p_w, int p_h,
     int presentation;
     int osd_max_height;
