+// Media mode: the layer shows a frame when its media timebase reaches the
+// frame's media PTS. The timebase runs at the servo's rate from its anchor,
+// so the host time that happens at is known; that host time is snapped as in
+// host mode and mapped back through the same timebase. The servo's rate
+// changes (100 ppm steps, at most every 200 ms) move it by microseconds over
+// a queue lead. Not before the timebase is anchored and running: the first
+// frame after a reset, a pause or a re-anchor keeps its PTS.
+static void vsync_snap_media_frame(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    double rate = p->timebase_applied_rate;
+    if (!p->timebase || !p->timebase_anchor_valid || p->playback_paused ||
+        !(rate > 0.0))
+    {
+        avf_vsync_snap_unlock(&p->vsync_snap);
+        p->vsync_stats.have_prev = false;
+        return;
+    }
+    int64_t before = mp_time_ns();
+    int64_t tb = cm_time_to_ns(CMTimebaseGetTime(p->timebase));
+    int64_t after = mp_time_ns();
+    int64_t now = before + (after - before) / 2;
+    int64_t target = now + (int64_t)llround((p->next_media_pts_ns - tb) / rate);
+    int64_t stamp = vsync_snap_frame(vo, target);
+    if (stamp != target) {
+        p->next_media_stamp_ns = p->next_media_pts_ns +
+                                 (int64_t)llround((stamp - target) * rate);
+        p->next_media_stamp_valid = true;
+    }
+}
