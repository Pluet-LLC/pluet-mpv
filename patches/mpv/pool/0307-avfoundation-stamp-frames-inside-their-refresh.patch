+// --- avf display refresh clock
+// The display's refresh instants for the vsync snap, from a CADisplayLink on
+// the main run loop. Its callback stores the latest refresh and the period
+// under `lock`; the VO thread only reads them, and never waits for the main
+// thread (see "avf main-thread link"): the link is made and torn down by
+// main-queue blocks the VO does not wait for. The period is measured over the
+// link's own timestamps once they span 12 refreshes, so a refresh extrapolated
+// a queue lead ahead stays exact to microseconds; a change of display mode
+// restarts the measurement.
+//
+// tvOS: a link at the display's own rate, which is the film's once the TV
+// has switched. iOS and macOS: a passive link asking for 15 callbacks a
+// second (AVF_REFRESH_LINK_HZ) so it never holds a ProMotion display at a
+// high rate; its timestamps still fall on refreshes, and the refresh interval
+// is the link's duration. macOS 14+ only: the link comes from the view
+// hosting the display layer (NSView's displayLink), which follows the window
+// to whichever display it is on; before the layer is in a view the clock
+// looks again once a second. Without a link the snap stays off.
+#define AVF_REFRESH_LINK_HZ 15
+@interface MPVDisplayRefreshClock : NSObject {
+@public
+    os_unfair_lock lock;
+    int64_t vsync_ns;    // lock: latest refresh, mp_time_ns() clock
+    int64_t period_ns;   // lock: refresh period (0 until the first callback)
+    int64_t nominal_ns;  // lock: the link's own refresh interval
+    // lock: the display layer's own counts (AVVideoPerformanceMetrics, tvOS
+    // and iOS 17.4, macOS 14.4), -1 until one has been read
+    int64_t layer_total, layer_dropped;
+    // Main thread only. A CADisplayLink (typed id: macOS has the class only
+    // from 14, and the engine deploys to 12).
+    id link;
+    CALayer *layer;      // macOS: the display layer, to find its view
+    bool stopped;
+    int attempts;
+    struct avf_refresh_run run;
+}
+- (void)refresh:(id)sender;
+- (void)tick:(CADisplayLink *)sender API_AVAILABLE(macos(14.0));
+@end
+
+@implementation MPVDisplayRefreshClock
+- (void)refresh:(id)sender
+{
+    if (@available(macOS 14.0, *))
+        [self tick:sender];
+}
+
+- (void)tick:(CADisplayLink *)sender
+{
+    // CACurrentMediaTime() and mp_time_ns() both count mach_absolute_time().
+    int64_t offset = mp_time_ns() - (int64_t)llround(CACurrentMediaTime() * 1e9);
+    int64_t vsync = (int64_t)llround(sender.timestamp * 1e9) + offset;
+#if TARGET_OS_TV
+    double interval = sender.targetTimestamp - sender.timestamp;
+    if (!(interval > 0))
+        interval = sender.duration;
+#else
+    // A passive link fires every few refreshes; duration is one refresh.
+    double interval = sender.duration;
+#endif
+    int64_t nominal = (int64_t)llround(interval * 1e9);
+    if (nominal <= 0)
+        return;
+    // tvOS: the link's own interval until measured. Elsewhere only a grid
+    // the timestamps have confirmed: an adaptive (ProMotion) display that
+    // runs below its duration's rate never confirms one, and the snap then
+    // stays off rather than snap to refreshes that are not there.
+    int64_t period = avf_refresh_measure(&run, vsync, nominal, TARGET_OS_TV);
+    os_unfair_lock_lock(&lock);
+    vsync_ns = vsync;
+    period_ns = period;
+    nominal_ns = nominal;
+    os_unfair_lock_unlock(&lock);
+}
+@end
+
+#if !TARGET_OS_IPHONE
+// The view whose layer tree holds `layer`, if it is in one.
+static NSView *avf_layer_view(CALayer *layer)
+{
+    for (CALayer *l = layer; l; l = l.superlayer) {
+        id delegate = l.delegate;
+        if ([delegate isKindOfClass:[NSView class]])
+            return delegate;
+    }
+    return nil;
+}
+#endif
+
+// Main thread: make the clock's link, or on macOS try again in a second
+// while the layer is not in a view yet (at most a minute).
+static void avf_refresh_clock_attach(MPVDisplayRefreshClock *clock)
+{
+    if (clock->stopped || clock->link)
+        return;
+    if (@available(macOS 14.0, *)) {
+        CADisplayLink *link = nil;
+#if TARGET_OS_IPHONE
+        link = [CADisplayLink displayLinkWithTarget:clock
+                                           selector:@selector(refresh:)];
+#else
+        NSView *view = avf_layer_view(clock->layer);
+        if (view)
+            link = [view displayLinkWithTarget:clock selector:@selector(refresh:)];
+        if (!link) {
+            if (++clock->attempts < 60) {
+                [clock retain];
+                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC),
+                               dispatch_get_main_queue(), ^{
+                    avf_refresh_clock_attach(clock);
+                    [clock release];
+                });
+            }
+            return;
+        }
+#endif
+#if !TARGET_OS_TV
+        if (@available(iOS 15.0, *)) {
+            link.preferredFrameRateRange = CAFrameRateRangeMake(
+                AVF_REFRESH_LINK_HZ / 2, AVF_REFRESH_LINK_HZ, AVF_REFRESH_LINK_HZ);
+        }
+#endif
+        [link addToRunLoop:[NSRunLoop mainRunLoop] forMode:NSRunLoopCommonModes];
+        clock->link = [link retain];
+    }
+}
+// --- end avf display refresh clock
+
+static void vsync_snap_start_clock(struct priv *p)
+{
+    if (p->refresh_clock || !p->displayLayer)
+        return;
+    MPVDisplayRefreshClock *clock = [[MPVDisplayRefreshClock alloc] init];
+    clock->lock = OS_UNFAIR_LOCK_INIT;
+    clock->layer_total = clock->layer_dropped = -1;
+    clock->layer = [p->displayLayer retain];
+    p->refresh_clock = clock;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        avf_refresh_clock_attach(clock);
+    });
+}
+
+// No wait: the main queue runs this after the block that made the link.
+static void vsync_snap_stop_clock(struct priv *p)
+{
+    MPVDisplayRefreshClock *clock = p->refresh_clock;
+    if (!clock)
+        return;
+    p->refresh_clock = nil;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        clock->stopped = true;
+        if (@available(macOS 14.0, *))
+            [(CADisplayLink *)clock->link invalidate];
+        [clock->link release];
+        clock->link = nil;
+        [clock->layer release];
+        clock->layer = nil;
+    });
+    [clock release];
+}
+
+// The latest refresh and the period, if the clock has a fresh one.
+static bool vsync_snap_grid(struct priv *p, int64_t now, int64_t *vsync,
+                            int64_t *period, int64_t *nominal)
+{
+    MPVDisplayRefreshClock *clock = p->refresh_clock;
+    if (!clock)
+        return false;
+    os_unfair_lock_lock(&clock->lock);
+    *vsync = clock->vsync_ns;
+    *period = clock->period_ns;
+    *nominal = clock->nominal_ns;
+    os_unfair_lock_unlock(&clock->lock);
+    // A main thread stalled for a second (or an app in the background, whose
+    // link stops) leaves no refresh to trust.
+    return *period > 0 && *vsync > 0 && now - *vsync < MP_TIME_MS_TO_NS(1000);
+}
+
+static int64_t vsync_mod(int64_t x, int64_t period)
+{
+    x -= avf_vsync_floor_div(x, period) * period;
+    return x;
+}
+
+// The display layer's own counts of frames shown and dropped, read about once
+// a second without waiting (the answer comes on another queue and is kept by
+// the refresh clock, which the block holds).
+static void vsync_snap_ask_layer(struct priv *p, int64_t now)
+{
+    MPVDisplayRefreshClock *clock = p->refresh_clock;
+    if (!clock || !p->displayLayer ||
+        now - p->vsync_metrics_asked_ns < MP_TIME_MS_TO_NS(1000))
+        return;
+    p->vsync_metrics_asked_ns = now;
+    if (@available(iOS 17.4, tvOS 17.4, macOS 14.4, *)) {
+        AVSampleBufferVideoRenderer *renderer = p->displayLayer.sampleBufferRenderer;
+        [clock retain];
+        [renderer loadVideoPerformanceMetricsWithCompletionHandler:
+            ^(AVVideoPerformanceMetrics *metrics) {
+                if (metrics) {
+                    os_unfair_lock_lock(&clock->lock);
+                    clock->layer_total = metrics.totalNumberOfFrames;
+                    clock->layer_dropped = metrics.numberOfDroppedFrames;
+                    os_unfair_lock_unlock(&clock->lock);
+                }
+                [clock release];
+            }];
+    }
+}
+
+static void vsync_snap_layer_counts(struct priv *p, int64_t *total,
+                                    int64_t *dropped)
+{
+    MPVDisplayRefreshClock *clock = p->refresh_clock;
+    *total = *dropped = -1;
+    if (!clock)
+        return;
+    os_unfair_lock_lock(&clock->lock);
+    *total = clock->layer_total;
+    *dropped = clock->layer_dropped;
+    os_unfair_lock_unlock(&clock->lock);
+}
+
+static void vsync_snap_report(struct vo *vo, int64_t now)
+{
+    struct priv *p = vo->priv;
+    struct avf_vsync_stats *st = &p->vsync_stats;
