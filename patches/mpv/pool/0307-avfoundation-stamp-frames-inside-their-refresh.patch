+// Decoded audio at one frame per refresh: ask the core to play the sound at
+// the display's pace (avf_av_servo_update) instead of stepping the picture.
+// The core declines for passthrough, and the steps then stay in charge.
+static void vsync_snap_servo(struct vo *vo, int mode, int64_t period, int64_t target_ns)
+{
+    struct priv *p = vo->priv;
+    double speed = 0;
+    // Another display mode is another clock pair: learn its mismatch anew.
+    if (llabs(period - p->vsync_servo_period) * 500 > period) {
+        p->vsync_servo = (struct avf_av_servo){0};
+        p->vsync_servo_period = period;
+    }
+    bool use = mode == AVF_VSYNC_SNAP_YES && p->presentation_host &&
+               p->opts->vsync_snap_resample_ppm > 0 &&
+               avf_vsync_one_to_one(&p->vsync_snap, (double)period) &&
+               p->vsync_snap.frames >= AVF_VSYNC_SNAP_ALPHA_DIV;
+    if (use) {
+        double dt = p->vsync_servo_t ? (target_ns - p->vsync_servo_t) / 1e9 : 0;
+        // The integral only learns while the core applies the speed.
+        if (!vo_get_audio_speed_applied(vo))
+            dt = 0;
+        speed = avf_av_servo_update(&p->vsync_servo, -p->vsync_snap.lock_ns / 1e6,
+                                    dt, p->opts->vsync_snap_resample_ppm);
+        p->vsync_servo_t = target_ns;
+    } else {
+        p->vsync_servo_t = 0;
+    }
+    // Sent on a change of 1 ppm or more (or on and off).
+    if ((speed == 0) != (p->vsync_speed_sent == 0) ||
+        fabs(speed - p->vsync_speed_sent) >= 1e-6)
+    {
+        vo_set_audio_speed_hint(vo, speed);
+        p->vsync_speed_sent = speed;
+    }
+}
+
+// Host mode: the stamp for a frame mpv planned for target_ns (see "avf vsync
+// snap"). --avfoundation-vsync-snap=measure works out and logs the same
+// stamps without using them.
+static int64_t vsync_snap_frame(struct vo *vo, int64_t target_ns)
+{
+    struct priv *p = vo->priv;
+    int mode = p->opts->vsync_snap;
+    if (mode == AVF_VSYNC_SNAP_NO) {
+        avf_vsync_snap_unlock(&p->vsync_snap);
+        p->vsync_stats.have_prev = false;
+        if (p->vsync_speed_sent) {
+            vo_set_audio_speed_hint(vo, 0);
+            p->vsync_speed_sent = 0;
+        }
+        return target_ns;
+    }
+    vsync_snap_start_clock(p);
+
+    int64_t now = mp_time_ns();
+    struct avf_vsync_stats *st = &p->vsync_stats;
+    vsync_snap_report(vo, now);
+    st->frames++;
+
+    int64_t vsync, period, nominal;
+    if (p->vsync_paused || !vsync_snap_grid(p, now, &vsync, &period, &nominal)) {
+        st->unsnapped++;
+        st->have_prev = false;
+        avf_vsync_snap_unlock(&p->vsync_snap);
+        return target_ns;
+    }
+
+    // Refreshes in the stamps' clock: the layer shows a frame on the first
+    // refresh at which its timebase (mp_time_ns() plus the offset) has
+    // reached the stamp, so a refresh at V is a boundary at V + offset.
+    // (Media mode passes host times it worked out from the timebase itself.)
+    if (p->presentation_host && p->timebase &&
+        (!p->vsync_tb_checked_ns ||
+         now - p->vsync_tb_checked_ns >= MP_TIME_MS_TO_NS(1000)))
+    {
+        int64_t before = mp_time_ns();
+        int64_t tb = cm_time_to_ns(CMTimebaseGetTime(p->timebase));
+        int64_t after = mp_time_ns();
+        p->vsync_tb_offset_ns = tb - (before + (after - before) / 2);
+        p->vsync_tb_checked_ns = now;
+    }
+    if (p->presentation_host)
+        vsync += p->vsync_tb_offset_ns;
+
+    // While the core resamples the sound to follow the display (and the
+    // servo has room), the picture's offset is held there and no step is
+    // taken by choice.
+    p->vsync_snap.hold = vo_get_audio_speed_applied(vo) && !p->vsync_servo.saturated;
+    p->vsync_snap.picture_early_ns = MP_TIME_MS_TO_NS(p->opts->vsync_snap_sound_late_ms);
+    p->vsync_snap.picture_late_ns = MP_TIME_MS_TO_NS(p->opts->vsync_snap_sound_early_ms);
+    int64_t shown = avf_vsync_snap_refresh(&p->vsync_snap, target_ns, vsync,
+                                           period);
+    int64_t stamp = shown - (int64_t)llround(period * p->opts->vsync_snap_lead);
+    int64_t used = mode == AVF_VSYNC_SNAP_YES ? stamp : target_ns;
+
+    // Diagnostics: where in the refresh the planned time and the stamp the
+    // layer gets fall, and which refresh each frame goes to.
+    st->period_ns = period;
+    st->nominal_ns = nominal;
+    st->frame_one_to_one = p->vsync_snap.frame_ns > 0 &&
+                           fabs(p->vsync_snap.frame_ns - period) * 64 < period;
+    avf_phase_add(&st->planned, vsync_mod(target_ns - vsync, period), period);
+    avf_phase_add(&st->stamped, vsync_mod(used - vsync, period), period);
+    double shift = shown - target_ns;
+    st->shift_sum += shift;
+    st->shift_max = MPMAX(st->shift_max, fabs(shift));
+    st->av_min = st->av_n ? MPMIN(st->av_min, shift) : shift;
+    st->av_max = st->av_n ? MPMAX(st->av_max, shift) : shift;
+    st->av_n++;
+    vsync_snap_servo(vo, mode, period, target_ns);
+
+    // Where each frame lands against its planned time: stamped as planned,
+    // under rule A (the first refresh at or after the stamp) and rule B (the
+    // nearest refresh), and snapped. A frame whose offset changes by 3/4 of a
+    // refresh or more from the frame before it was a refresh early or late
+    // against it: a skip or a repeat. A cadence's own steps (half a refresh
+    // at 24 fps on 60 Hz, 0.6 at 25 on 60) stay under that.
+    int64_t err_a = vsync - target_ns -
+                    avf_vsync_floor_div(vsync - target_ns, period) * period;
+    int64_t err_b = err_a > period / 2 ? err_a - period : err_a;
+    int64_t err_s = shown - target_ns;
+    if (target_ns + err_a != shown)
+        st->moved++;
+    if (st->have_prev && st->prev_relocks == p->vsync_snap.relocks) {
+        int64_t big = period * 3 / 4;
+        st->uneven_a += llabs(err_a - st->prev_err_a) >= big;
+        st->uneven_b += llabs(err_b - st->prev_err_b) >= big;
+        st->uneven_s += llabs(err_s - st->prev_err_s) >= big;
+        // The snap's refreshes, one after the other: a step of one refresh
+        // per frame is one frame each; none, two frames in one refresh; more,
+        // refreshes left without a new frame. (A cadence such as 24 fps on
+        // 60 Hz counts its own longer steps here.)
+        int64_t step = (shown - st->prev_shown + period / 2) / period;
+        if (step == 1)
+            st->occ_one++;
+        else if (step <= 0)
+            st->occ_two++;
+        else
+            st->occ_none += (int)(step - 1);
+    }
+    st->have_prev = true;
+    st->prev_err_a = err_a;
+    st->prev_err_b = err_b;
+    st->prev_err_s = err_s;
+    st->prev_relocks = p->vsync_snap.relocks;
+    st->prev_shown = shown;
+
+    if (p->presentation_host) {
+        p->vsync_frame_snapped = true;
+        p->vsync_frame_planned_ns = target_ns;
+        p->vsync_frame_stamp_ns = used - p->vsync_tb_offset_ns;
+    }
+    return used;
+}
+
+// Sample the frame's luma on a sparse grid and work out what it offers as a
+// place to hide a step (struct avf_step_cand): a cut from the frame before
+// (avf_vsync_quiet_kind), the frame before being black or uniform, and the
+// change a skip or a repeat would make. Every format mpv gives this VO is
+// read: VideoToolbox's 8- and 10-bit biplanar, packed 4:2:2 and RGB
+// outputs, and the software formats query_format() takes. Only a buffer
+// that cannot be locked (or a compressed format nothing here asks for)
+// gives no candidate (counted as unreadable), and a step then waits for the
+// end of the lip-sync range.
+static struct avf_step_cand vsync_frame_candidate(struct vo *vo, struct mp_image *img)
+{
+    struct priv *p = vo->priv;
+    struct avf_step_cand cand = {0};
+    const uint8_t *base = NULL;
+    size_t stride = 0;
+    // A luma sample: `step` bytes per pixel, the value at byte `at` (8 bit)
+    // or as a little-endian 16-bit word shifted right by `shift`.
+    int w = 0, h = 0, step = 0, at = 0, shift = -1;
+    CVPixelBufferRef pb = NULL;
+    if (!img) {
+        p->vsync_grids = 0;
+        return cand;
+    }
+    if (img->imgfmt == IMGFMT_VIDEOTOOLBOX) {
+        pb = (CVPixelBufferRef)img->planes[3];
+        int plane = 0;
+        switch (pb ? CVPixelBufferGetPixelFormatType(pb) : 0) {
+        // 8-bit Y'CbCr, biplanar 4:2:0, 4:2:2, 4:4:4 (what VideoToolbox gives
+        // for 8-bit H.264 and HEVC: FFmpeg asks it for NV12).
+        case kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange:
+        case kCVPixelFormatType_420YpCbCr8BiPlanarFullRange:
+        case kCVPixelFormatType_422YpCbCr8BiPlanarVideoRange:
+        case kCVPixelFormatType_422YpCbCr8BiPlanarFullRange:
+        case kCVPixelFormatType_444YpCbCr8BiPlanarVideoRange:
+        case kCVPixelFormatType_444YpCbCr8BiPlanarFullRange:
+            step = 1;
+            break;
+        // 10-bit, MSB-aligned in 16 bits (10-bit HEVC, HDR10 and Dolby
+        // Vision 5/8: FFmpeg asks for P010), 4:2:0, 4:2:2, 4:4:4.
+        case kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange:
+        case kCVPixelFormatType_420YpCbCr10BiPlanarFullRange:
+        case kCVPixelFormatType_422YpCbCr10BiPlanarVideoRange:
+        case kCVPixelFormatType_422YpCbCr10BiPlanarFullRange:
+        case kCVPixelFormatType_444YpCbCr10BiPlanarVideoRange:
+        case kCVPixelFormatType_444YpCbCr10BiPlanarFullRange:
+            step = 2;
+            shift = 8;
+            break;
+        // Packed 4:2:2: Y in every second byte.
+        case kCVPixelFormatType_422YpCbCr8:         // '2vuy' (UYVY)
+            step = 2;
+            at = 1;
+            break;
+        case kCVPixelFormatType_422YpCbCr8_yuvs:    // 'yuvs' (YUYV)
+            step = 2;
+            break;
+        // RGB: green stands in for luma.
+        case kCVPixelFormatType_32BGRA:
+        case kCVPixelFormatType_32ARGB:
+            step = 4;
+            at = CVPixelBufferGetPixelFormatType(pb) == kCVPixelFormatType_32BGRA ? 1 : 2;
+            break;
+        }
+        // Compressed (lossless/lossy AGX) and other formats are not CPU
+        // readable: FFmpeg never asks VideoToolbox for them.
+        if (step && CVPixelBufferLockBaseAddress(pb, kCVPixelBufferLock_ReadOnly) == kCVReturnSuccess) {
+            bool planar = CVPixelBufferIsPlanar(pb);
+            base = planar ? CVPixelBufferGetBaseAddressOfPlane(pb, plane)
+                          : CVPixelBufferGetBaseAddress(pb);
+            stride = planar ? CVPixelBufferGetBytesPerRowOfPlane(pb, plane)
+                            : CVPixelBufferGetBytesPerRow(pb);
+            w = (int)(planar ? CVPixelBufferGetWidthOfPlane(pb, plane) : CVPixelBufferGetWidth(pb));
+            h = (int)(planar ? CVPixelBufferGetHeightOfPlane(pb, plane) : CVPixelBufferGetHeight(pb));
+        } else {
+            pb = NULL;
+        }
+    } else if (img->imgfmt == IMGFMT_NV12 || img->imgfmt == IMGFMT_420P ||
+               img->imgfmt == IMGFMT_P010 || img->imgfmt == imgfmt_420p10() ||
+               img->imgfmt == imgfmt_420p12()) {
+        // Software decoding (AV1, VP9, anything VideoToolbox does not take).
+        step = img->imgfmt == IMGFMT_NV12 || img->imgfmt == IMGFMT_420P ? 1 : 2;
+        shift = img->imgfmt == IMGFMT_P010 ? 8 : img->imgfmt == imgfmt_420p10() ? 2
+              : img->imgfmt == imgfmt_420p12() ? 4 : -1;
+        base = img->planes[0];
+        stride = img->stride[0] > 0 ? img->stride[0] : 0;
+        w = img->w;
+        h = img->h;
+    }
+    if (!base || !stride || w < AVF_QUIET_GRID_W || h < AVF_QUIET_GRID_H) {
+        if (pb)
+            CVPixelBufferUnlockBaseAddress(pb, kCVPixelBufferLock_ReadOnly);
+        p->vsync_grids = 0;
+        p->vsync_stats.unreadable++;
+        return cand;
+    }
+    enum { N = AVF_QUIET_GRID_W * AVF_QUIET_GRID_H };
+    uint8_t grid[N];
+    double sum = 0, sum2 = 0;
+    for (int y = 0; y < AVF_QUIET_GRID_H; y++) {
+        const uint8_t *row = base + stride * (size_t)((2 * y + 1) * h / (2 * AVF_QUIET_GRID_H));
+        for (int x = 0; x < AVF_QUIET_GRID_W; x++) {
+            const uint8_t *px = row + (size_t)((2 * x + 1) * w / (2 * AVF_QUIET_GRID_W)) * step;
+            uint8_t v = shift < 0 ? px[at]
+                                  : (uint8_t)MPMIN(255, (px[0] | px[1] << 8) >> shift);
+            grid[y * AVF_QUIET_GRID_W + x] = v;
+            sum += v;
+            sum2 += (double)v * v;
+        }
+    }
+    if (pb)
+        CVPixelBufferUnlockBaseAddress(pb, kCVPixelBufferLock_ReadOnly);
+    double mean = sum / N, sd = sqrt(fmax(0, sum2 / N - mean * mean));
+    // vsync_grid[0] is the frame before, [1] the one before that.
+    if (p->vsync_grids >= 2) {
+        double d1 = 0;
+        for (int i = 0; i < N; i++)
+            d1 += abs((int)grid[i] - (int)p->vsync_grid[0][i]);
+        d1 /= N;
+        int kind = avf_vsync_quiet_kind(d1, &p->vsync_typical_diff);
+        cand.valid = true;
+        cand.kind = kind == 1 ? 1 : avf_grid_flat(p->vsync_grid_mean, p->vsync_grid_sd) ? 2 : 0;
+        cand.repeat = avf_grid_score(grid, p->vsync_grid[0], N);
+        cand.skip = avf_grid_score(grid, p->vsync_grid[1], N);
+        struct avf_vsync_stats *st = &p->vsync_stats;
+        st->sampled++;
+        st->cuts += cand.kind == 1;
+        st->flats += cand.kind == 2;
+        st->stills += kind == 2;
+    }
+    memcpy(p->vsync_grid[1], p->vsync_grid[0], N);
+    memcpy(p->vsync_grid[0], grid, N);
+    p->vsync_grid_mean = mean;
+    p->vsync_grid_sd = sd;
+    p->vsync_grids = MPMIN(p->vsync_grids + 1, 2);
+    return cand;
+}
+
+// Host mode, in flip_page: hold a snapped frame until the pacing point of the
+// refresh (see avf_vsync_pace_ns()), then note where its enqueue fell. Called
+// just before the frame goes to the layer (ready_wait: how long flip_page
+// waited for the layer to take more) and, with pace, also at flip_page's start.
+#define AVF_VSYNC_PACE_MIN_LEAD_NS MP_TIME_MS_TO_NS(40)
+
+static void vsync_pace_wait(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    p->vsync_pace_wait_ns = 0;
+    if (!p->vsync_frame_snapped || p->opts->vsync_snap != AVF_VSYNC_SNAP_YES ||
+        p->opts->vsync_snap_pace == AVF_VSYNC_PACE_NO)
+        return;
+    int64_t now = mp_time_ns(), vsync, period, nominal;
+    if (!vsync_snap_grid(p, now, &vsync, &period, &nominal))
+        return;
+    // A fixed point, or auto's starting one: the option (again when set).
+    if (p->opts->vsync_snap_pace == AVF_VSYNC_PACE_YES ||
+        p->opts->vsync_snap_pace_phase != p->vsync_pace_opt)
+    {
+        p->vsync_pace.phase = p->opts->vsync_snap_pace_phase;
+        p->vsync_pace_opt = p->opts->vsync_snap_pace_phase;
+        p->vsync_pace.bad_windows = 0;
+    }
+    // Aimed early by how late the enqueue has been after the point (the
+    // OSD enqueue and the readiness check between them, a few ms).
+    int64_t phase = (int64_t)llround(period * p->vsync_pace.phase) -
+                    (int64_t)p->vsync_pace_late_ns;
+    int64_t at = avf_vsync_pace_ns(now, p->vsync_frame_stamp_ns, vsync, period,
+                                   phase, AVF_VSYNC_PACE_MIN_LEAD_NS);
+    p->vsync_pace_at_ns = at > now ? at + (int64_t)p->vsync_pace_late_ns : 0;
+    if (at > now) {
+        mp_sleep_ns(at - now);
+        p->vsync_pace_wait_ns = at - now;
+    }
+}
+
+static void vsync_note_enqueue(struct vo *vo, int64_t ready_wait_ns)
+{
+    struct priv *p = vo->priv;
+    if (!p->vsync_frame_snapped)
+        return;
+    p->vsync_frame_snapped = false;
+    struct avf_vsync_stats *st = &p->vsync_stats;
+    int64_t now = mp_time_ns(), vsync, period, nominal;
+    if (!vsync_snap_grid(p, now, &vsync, &period, &nominal))
+        return;
+    avf_phase_add(&st->enqueued, vsync_mod(now - vsync, period), period);
+    if (p->vsync_pace_at_ns) {
+        double late = (double)(now - p->vsync_pace_at_ns);
+        late = fmax(-2e6, fmin(10e6, late));
+        p->vsync_pace_late_ns = fmax(0, fmin(8e6, p->vsync_pace_late_ns +
+                                     (late - 0) / 16));
+        p->vsync_pace_at_ns = 0;
+    }
+    double lead = p->vsync_frame_stamp_ns - now;
+    st->lead_min = st->enq ? MPMIN(st->lead_min, lead) : lead;
+    st->lead_max = st->enq ? MPMAX(st->lead_max, lead) : lead;
+    st->lead_sum += lead;
+    st->pace_sum += p->vsync_pace_wait_ns;
+    st->pace_max = MPMAX(st->pace_max, p->vsync_pace_wait_ns);
+    st->ready_sum += ready_wait_ns;
+    st->ready_max = MPMAX(st->ready_max, ready_wait_ns);
+    st->enq++;
+}
