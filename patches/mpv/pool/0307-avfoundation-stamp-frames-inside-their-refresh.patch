+// --avfoundation-expect-monotonic: promise the video renderer that stamps
+// only go up (they do: host stamps never go back, and a seek flushes), which
+// AVSampleBufferVideoRenderer takes as leave to do less per frame (tvOS and
+// iOS 17.4, macOS 14.4). A flush forgets the promise, so it is made again
+// before the first frame after one.
+static void expect_monotonic_stamps(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    if (!p->opts->expect_monotonic || p->monotonic_told || !p->displayLayer)
+        return;
+    p->monotonic_told = true;
+    if (@available(iOS 17.4, tvOS 17.4, macOS 14.4, *)) {
+        AVSampleBufferVideoRenderer *renderer = p->displayLayer.sampleBufferRenderer;
+        SEL expect = NSSelectorFromString(
+            @"expectMonotonicallyIncreasingUpcomingSampleBufferPresentationTimes");
+        if ([renderer respondsToSelector:expect]) {
+            ((void (*)(id, SEL))[renderer methodForSelector:expect])(renderer, expect);
+            MP_VERBOSE(vo, "the video renderer was told stamps only go up\n");
+        }
+    }
+}
