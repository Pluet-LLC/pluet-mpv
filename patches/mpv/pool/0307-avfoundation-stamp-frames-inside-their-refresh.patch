+//
+// tvOS: a link at the display's own rate, which is the film's once the TV
+// has switched. iOS and macOS: a passive link asking for 15 callbacks a
+// second (AVF_REFRESH_LINK_HZ) so it never holds a ProMotion display at a
+// high rate; its timestamps still fall on refreshes, and the refresh interval
+// is the link's duration. macOS 14+ only: the link comes from the view
+// hosting the display layer (NSView's displayLink), which follows the window
+// to whichever display it is on; before the layer is in a view the clock
+// looks again once a second. Without a link the snap stays off.
+#define AVF_REFRESH_LINK_HZ 15
+@interface MPVDisplayRefreshClock : NSObject {
+@public
+    os_unfair_lock lock;
+    int64_t vsync_ns;    // lock: latest refresh, mp_time_ns() clock
+    int64_t period_ns;   // lock: refresh period (0 until the first callback)
+    int64_t nominal_ns;  // lock: the link's own refresh interval
+    // lock: the display layer's own counts (AVVideoPerformanceMetrics, tvOS
+    // and iOS 17.4, macOS 14.4), -1 until one has been read
+    int64_t layer_total, layer_dropped;
+    // Main thread only. A CADisplayLink (typed id: macOS has the class only
+    // from 14, and the engine deploys to 12).
+    id link;
+    CALayer *layer;      // macOS: the display layer, to find its view
+    bool stopped;
+    int attempts;
+    struct avf_refresh_run run;
+}
+- (void)refresh:(id)sender;
+- (void)tick:(CADisplayLink *)sender API_AVAILABLE(macos(14.0));
+@end
+
+@implementation MPVDisplayRefreshClock
+- (void)refresh:(id)sender
+{
+    if (@available(macOS 14.0, *))
+        [self tick:sender];
+}
+
+- (void)tick:(CADisplayLink *)sender
+{
+    // CACurrentMediaTime() and mp_time_ns() both count mach_absolute_time().
+    int64_t offset = mp_time_ns() - (int64_t)llround(CACurrentMediaTime() * 1e9);
+    int64_t vsync = (int64_t)llround(sender.timestamp * 1e9) + offset;
+#if TARGET_OS_TV
+    double interval = sender.targetTimestamp - sender.timestamp;
+    if (!(interval > 0))
+        interval = sender.duration;
+#else
+    // A passive link fires every few refreshes; duration is one refresh.
+    double interval = sender.duration;
+#endif
+    int64_t nominal = (int64_t)llround(interval * 1e9);
+    if (nominal <= 0)
+        return;
+    // tvOS: the link's own interval until measured. Elsewhere only a grid
+    // the timestamps have confirmed: an adaptive (ProMotion) display that
+    // runs below its duration's rate never confirms one, and the snap then
+    // stays off rather than snap to refreshes that are not there.
+    int64_t period = avf_refresh_measure(&run, vsync, nominal, TARGET_OS_TV);
+    os_unfair_lock_lock(&lock);
+    vsync_ns = vsync;
+    period_ns = period;
+    nominal_ns = nominal;
+    os_unfair_lock_unlock(&lock);
+}
+@end
+
+#if !TARGET_OS_IPHONE
+// The view whose layer tree holds `layer`, if it is in one.
+static NSView *avf_layer_view(CALayer *layer)
+{
+    for (CALayer *l = layer; l; l = l.superlayer) {
+        id delegate = l.delegate;
+        if ([delegate isKindOfClass:[NSView class]])
+            return delegate;
+    }
+    return nil;
+}
+#endif
+
+// Main thread: make the clock's link, or on macOS try again in a second
+// while the layer is not in a view yet (at most a minute).
+static void avf_refresh_clock_attach(MPVDisplayRefreshClock *clock)
+{
+    if (clock->stopped || clock->link)
+        return;
+    if (@available(macOS 14.0, *)) {
+        CADisplayLink *link = nil;
+#if TARGET_OS_IPHONE
+        link = [CADisplayLink displayLinkWithTarget:clock
+                                           selector:@selector(refresh:)];
+#else
+        NSView *view = avf_layer_view(clock->layer);
+        if (view)
+            link = [view displayLinkWithTarget:clock selector:@selector(refresh:)];
+        if (!link) {
+            if (++clock->attempts < 60) {
+                [clock retain];
+                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC),
+                               dispatch_get_main_queue(), ^{
+                    avf_refresh_clock_attach(clock);
+                    [clock release];
+                });
+            }
+            return;
+        }
+#endif
+#if !TARGET_OS_TV
+        if (@available(iOS 15.0, *)) {
+            link.preferredFrameRateRange = CAFrameRateRangeMake(
+                AVF_REFRESH_LINK_HZ / 2, AVF_REFRESH_LINK_HZ, AVF_REFRESH_LINK_HZ);
+        }
+#endif
+        [link addToRunLoop:[NSRunLoop mainRunLoop] forMode:NSRunLoopCommonModes];
+        clock->link = [link retain];
+    }
+}
+// --- end avf display refresh clock
+
+static void vsync_snap_start_clock(struct priv *p)
+{
+    if (p->refresh_clock || !p->displayLayer)
+        return;
+    MPVDisplayRefreshClock *clock = [[MPVDisplayRefreshClock alloc] init];
+    clock->lock = OS_UNFAIR_LOCK_INIT;
+    clock->layer_total = clock->layer_dropped = -1;
+    clock->layer = [p->displayLayer retain];
+    p->refresh_clock = clock;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        avf_refresh_clock_attach(clock);
+    });
+}
+
+// No wait: the main queue runs this after the block that made the link.
+static void vsync_snap_stop_clock(struct priv *p)
+{
+    MPVDisplayRefreshClock *clock = p->refresh_clock;
+    if (!clock)
+        return;
+    p->refresh_clock = nil;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        clock->stopped = true;
+        if (@available(macOS 14.0, *))
+            [(CADisplayLink *)clock->link invalidate];
+        [clock->link release];
+        clock->link = nil;
+        [clock->layer release];
+        clock->layer = nil;
+    });
+    [clock release];
+}
+
+// The latest refresh and the period, if the clock has a fresh one.
+static bool vsync_snap_grid(struct priv *p, int64_t now, int64_t *vsync,
+                            int64_t *period, int64_t *nominal)
+{
+    MPVDisplayRefreshClock *clock = p->refresh_clock;
+    if (!clock)
+        return false;
+    os_unfair_lock_lock(&clock->lock);
+    *vsync = clock->vsync_ns;
+    *period = clock->period_ns;
+    *nominal = clock->nominal_ns;
+    os_unfair_lock_unlock(&clock->lock);
+    // A main thread stalled for a second (or an app in the background, whose
+    // link stops) leaves no refresh to trust.
+    return *period > 0 && *vsync > 0 && now - *vsync < MP_TIME_MS_TO_NS(1000);
+}
+
+static int64_t vsync_mod(int64_t x, int64_t period)
+{
+    x -= avf_vsync_floor_div(x, period) * period;
+    return x;
+}
+
+// The display layer's own counts of frames shown and dropped, read about once
+// a second without waiting (the answer comes on another queue and is kept by
+// the refresh clock, which the block holds).
+static void vsync_snap_ask_layer(struct priv *p, int64_t now)
+{
+    MPVDisplayRefreshClock *clock = p->refresh_clock;
+    if (!clock || !p->displayLayer)
+        return;
+    // --avfoundation-vsync-snap-ask-ms=0: the layer is never asked (auto
+    // pacing then keeps its point, as on a system without the counts).
+    int every_ms = p->opts->vsync_snap_ask_ms;
+    if (every_ms <= 0) {
+        os_unfair_lock_lock(&clock->lock);
+        clock->layer_total = clock->layer_dropped = -1;
+        os_unfair_lock_unlock(&clock->lock);
+        p->vsync_metrics_asked_ns = 0;
+        return;
+    }
+    if (p->vsync_metrics_asked_ns &&
+        now - p->vsync_metrics_asked_ns < MP_TIME_MS_TO_NS(every_ms))
+        return;
+    p->vsync_metrics_asked_ns = now;
+    p->vsync_stats.asks++;
+    if (@available(iOS 17.4, tvOS 17.4, macOS 14.4, *)) {
+        AVSampleBufferVideoRenderer *renderer = p->displayLayer.sampleBufferRenderer;
+        [clock retain];
+        [renderer loadVideoPerformanceMetricsWithCompletionHandler:
+            ^(AVVideoPerformanceMetrics *metrics) {
+                if (metrics) {
+                    os_unfair_lock_lock(&clock->lock);
+                    clock->layer_total = metrics.totalNumberOfFrames;
+                    clock->layer_dropped = metrics.numberOfDroppedFrames;
+                    os_unfair_lock_unlock(&clock->lock);
+                }
+                [clock release];
+            }];
+    }
+}
+
+static void vsync_snap_layer_counts(struct priv *p, int64_t *total,
+                                    int64_t *dropped)
+{
+    MPVDisplayRefreshClock *clock = p->refresh_clock;
+    *total = *dropped = -1;
+    if (!clock)
+        return;
+    os_unfair_lock_lock(&clock->lock);
+    *total = clock->layer_total;
+    *dropped = clock->layer_dropped;
+    os_unfair_lock_unlock(&clock->lock);
+}
+
+static void vsync_pace_save(struct vo *vo);
+
+static void vsync_snap_report(struct vo *vo, int64_t now)
+{
+    struct priv *p = vo->priv;
+    struct avf_vsync_stats *st = &p->vsync_stats;
+
+    vsync_snap_ask_layer(p, now);
+    int64_t total, dropped;
+    vsync_snap_layer_counts(p, &total, &dropped);
+
+    if (!st->window_start_ns) {
+        st->window_start_ns = now;
+        st->layer_total0 = total;
+        st->layer_dropped0 = dropped;
+        p->vsync_layer_dropped_seen = dropped;
+        return;
+    }
+    // When the layer's dropped count rose (as far as the asks resolve it).
+    if (dropped >= 0 && p->vsync_layer_dropped_seen >= 0 &&
+        dropped > p->vsync_layer_dropped_seen &&
+        st->drop_marks < (int)MP_ARRAY_SIZE(st->drop_at_s))
+    {
+        st->drop_at_s[st->drop_marks++] = (now - st->window_start_ns) / 1e9;
+    }
+    p->vsync_layer_dropped_seen = dropped;
+    if (now - st->window_start_ns < MP_TIME_MS_TO_NS(5000))
+        return;
+    // The layer's counts over the window (a new layer starts them again).
+    int64_t lshown = -1, ldropped = -1;
+    if (st->layer_total0 >= 0 && total >= st->layer_total0 &&
+        dropped >= st->layer_dropped0)
+    {
+        ldropped = dropped - st->layer_dropped0;
+        lshown = total - st->layer_total0 - ldropped;
+        if (lshown < 0)
+            lshown = total - st->layer_total0;
+    }
+    bool paced = p->opts->vsync_snap == AVF_VSYNC_SNAP_YES &&
+                 p->opts->vsync_snap_pace != AVF_VSYNC_PACE_NO &&
+                 p->presentation_host;
+    // Auto pacing judges steady windows only: a start, a seek or a pause
+    // (a new lock, frames without a refresh) drops frames of its own, and
+    // the counts read just after one still hold them.
+    bool moved_pace = false;
+    if (paced && p->opts->vsync_snap_pace == AVF_VSYNC_PACE_AUTO && lshown >= 0 &&
+        p->vsync_pace_period)
+    {
+        bool steady = st->unsnapped == 0 && p->vsync_snap.relocks == st->relocks0 &&
+                      st->frames >= AVF_PACE_MIN_FRAMES;
+        if (!steady) {
+            p->vsync_pace.settle = MPMAX(p->vsync_pace.settle, 1);
+        } else {
+            int r = avf_vsync_pace_feed(&p->vsync_pace, lshown, ldropped);
+            moved_pace = r == 1;
+            if (r)
+                vsync_pace_save(vo);
+        }
+    }
+    if (st->frames) {
+        int n = MPMAX(st->frames - st->unsnapped, 1);
+        static const char *const modes[] = {"off", "on", "measure"};
+        double per = MPMAX(st->period_ns, 1);
+        // Three lines, each short enough for a host that keeps 200 characters.
+        MP_VERBOSE(vo, "vsync-snap %s: %d frames/%.1fs (%d no refresh), refresh "
+                   "%.3f ms (link %.3f), lock %+.2f ms, layer %+.3f ms, moved=%d, "
+                   "shift avg %+.2f max %.2f ms, relocks=%d reslots=%d\n",
+                   modes[p->opts->vsync_snap], st->frames,
+                   (now - st->window_start_ns) / 1e9, st->unsnapped,
+                   st->period_ns / 1e6, st->nominal_ns / 1e6,
+                   -p->vsync_snap.lock_ns / 1e6, p->vsync_tb_offset_ns / 1e6,
+                   st->moved, st->shift_sum / n / 1e6, st->shift_max / 1e6,
+                   p->vsync_snap.relocks - st->relocks0,
+                   p->vsync_snap.reslots - st->reslots0);
+        // Offsets past the link's refresh instant: mean [spread around it].
+        double pa, pl, ph, sa, sl, sh, ea = 0, el = 0, eh = 0;
+        avf_phase_get(&st->planned, per, &pa, &pl, &ph);
+        avf_phase_get(&st->stamped, per, &sa, &sl, &sh);
+        if (st->enqueued.n)
+            avf_phase_get(&st->enqueued, per, &ea, &el, &eh);
+        MP_VERBOSE(vo, "vsync-snap phase (ms past refresh): planned %.2f [%+.2f %+.2f], "
+                   "stamp %.2f [%+.2f %+.2f], enqueue %.2f [%+.2f %+.2f], refreshes "
+                   "1:%d 2:%d 0:%d, uneven A=%d B=%d S=%d\n",
+                   pa / 1e6, pl / 1e6, ph / 1e6, sa / 1e6, sl / 1e6, sh / 1e6,
+                   ea / 1e6, el / 1e6, eh / 1e6, st->occ_one, st->occ_two, st->occ_none,
+                   st->uneven_a, st->uneven_b, st->uneven_s);
+        int ne = MPMAX(st->enq, 1);
+        MP_VERBOSE(vo, "vsync-snap pace %s %.2f: lead min %.1f avg %.1f max %.1f ms, "
+                   "pace wait avg %.1f max %.1f, ready wait avg %.1f max %.1f, layer "
+                   "shown %lld dropped %lld, steps=%d %s%s\n",
+                   paced ? (p->opts->vsync_snap_pace == AVF_VSYNC_PACE_AUTO ? "auto" : "yes")
+                         : "off", p->vsync_pace.phase,
+                   st->lead_min / 1e6, st->lead_sum / ne / 1e6, st->lead_max / 1e6,
+                   st->pace_sum / ne / 1e6, st->pace_max / 1e6,
+                   st->ready_sum / ne / 1e6, st->ready_max / 1e6,
+                   (long long)lshown, (long long)ldropped, p->vsync_pace.steps,
+                   p->vsync_pace.held ? "held" : p->vsync_pace.rest ? "rest" : "search",
+                   moved_pace ? " (moved)" : "");
+        // Lip sync and steps: the picture's offset from its sound (+: the
+        // picture late, the sound early), the drift, the resampling asked
+        // and applied, and every step by where it was hidden.
+        const struct avf_vsync_snap *sn = &p->vsync_snap;
+        static const char *const kinds[] = {"-", "cut", "black", "still", "low", "forced"};
+        MP_VERBOSE(vo, "vsync-snap sync: av %+.1f..%+.1f ms, drift %+.1f ppm, resample "
+                   "%+.1f ppm%s; steps cut %d black %d still %d low %d forced %d, "
+                   "last %s %.2f at %+.1f ms; sampled %d cuts %d flat %d unread %d\n",
+                   st->av_n ? st->av_min / 1e6 : 0, st->av_n ? st->av_max / 1e6 : 0,
+                   sn->drift * 1000, (p->vsync_speed_sent ? p->vsync_speed_sent - 1 : 0) * 1e6,
+                   vo_get_audio_speed_applied(vo) ? " on" : " off",
+                   sn->steps_by_kind[AVF_STEP_CUT], sn->steps_by_kind[AVF_STEP_BLACK],
+                   sn->steps_by_kind[AVF_STEP_STILL], sn->steps_by_kind[AVF_STEP_LOW],
+                   sn->steps_by_kind[AVF_STEP_FORCED], kinds[sn->last_kind],
+                   sn->last_score, sn->last_av_ns / 1e6, st->sampled, st->cuts, st->flats,
+                   st->unreadable);
+        // The VO's own work: where in the refresh it starts on a frame, the
+        // cost of reading the luma, the asks, and when drops were seen.
+        double wa = 0, wl = 0, wh = 0;
+        if (st->prep.n)
+            avf_phase_get(&st->prep, per, &wa, &wl, &wh);
+        char marks[64] = "-";
+        for (int i = 0, at = 0; i < st->drop_marks && at < (int)sizeof(marks) - 8; i++)
+            at += snprintf(marks + at, sizeof(marks) - at, "%s%.1f", i ? "," : "",
+                           st->drop_at_s[i]);
+        int ns = MPMAX(st->sampled + st->unreadable, 1);
+        MP_VERBOSE(vo, "vsync-snap work: start %.2f [%+.2f %+.2f] ms past refresh, "
+                   "luma %s avg %.0f max %.0f us, layer asked %d (every %d ms), "
+                   "drops seen at s: %s, pace started from the %s\n",
+                   wa / 1e6, wl / 1e6, wh / 1e6,
+                   p->opts->vsync_snap_sample ? "read" : "not read",
+                   st->sample_ns / (double)ns / 1e3, st->sample_max_ns / 1e3,
+                   st->asks, p->opts->vsync_snap_ask_ms, marks,
+                   p->vsync_pace_origin ? p->vsync_pace_origin : "-");
+        // Subtitle (OSD) samples handed to their layer in the window: how
+        // many, what the enqueues took, and when, to set beside the drops.
+        char osd_marks[80] = "-";
+        for (int i = 0, at = 0; i < st->osd_marks && at < (int)sizeof(osd_marks) - 8; i++)
+            at += snprintf(osd_marks + at, sizeof(osd_marks) - at, "%s%.1f", i ? "," : "",
+                           st->osd_at_s[i]);
+        MP_VERBOSE(vo, "vsync-snap osd: %d enqueued %s the video, enqueue avg %.1f "
+                   "max %.1f ms, at s: %s\n", st->osd_enq,
+                   p->opts->osd_after_video ? "after" : "before",
+                   st->osd_enq_ns / (double)MPMAX(st->osd_enq, 1) / 1e6,
+                   st->osd_enq_max_ns / 1e6, osd_marks);
+    }
+    struct avf_vsync_stats next = {
+        .window_start_ns = now,
+        .relocks0 = p->vsync_snap.relocks,
+        .reslots0 = p->vsync_snap.reslots,
+        .have_prev = st->have_prev,
+        .prev_err_a = st->prev_err_a,
+        .prev_err_b = st->prev_err_b,
+        .prev_err_s = st->prev_err_s,
+        .prev_relocks = st->prev_relocks,
+        .prev_shown = st->prev_shown,
+        .layer_total0 = total,
+        .layer_dropped0 = dropped,
+    };
+    *st = next;
+}
+
+// Decoded audio at one frame per refresh: ask the core to play the sound at
+// the display's pace (avf_av_servo_update) instead of stepping the picture.
+// The core declines for passthrough, and the steps then stay in charge.
+static void vsync_snap_servo(struct vo *vo, int mode, int64_t period, int64_t target_ns)
+{
+    struct priv *p = vo->priv;
+    double speed = 0;
+    // Another display mode is another clock pair: learn its mismatch anew.
+    if (llabs(period - p->vsync_servo_period) * 500 > period) {
+        p->vsync_servo = (struct avf_av_servo){0};
+        p->vsync_servo_period = period;
+    }
+    bool use = mode == AVF_VSYNC_SNAP_YES && p->presentation_host &&
+               p->opts->vsync_snap_resample_ppm > 0 &&
+               avf_vsync_one_to_one(&p->vsync_snap, (double)period) &&
+               p->vsync_snap.frames >= AVF_VSYNC_SNAP_ALPHA_DIV;
+    if (use) {
+        double dt = p->vsync_servo_t ? (target_ns - p->vsync_servo_t) / 1e9 : 0;
+        // The integral only learns while the core applies the speed.
+        if (!vo_get_audio_speed_applied(vo))
+            dt = 0;
+        speed = avf_av_servo_update(&p->vsync_servo, -p->vsync_snap.lock_ns / 1e6,
+                                    dt, p->opts->vsync_snap_resample_ppm);
+        p->vsync_servo_t = target_ns;
+    } else {
+        p->vsync_servo_t = 0;
+    }
+    // Sent on a change of 1 ppm or more (or on and off).
+    if ((speed == 0) != (p->vsync_speed_sent == 0) ||
+        fabs(speed - p->vsync_speed_sent) >= 1e-6)
+    {
+        vo_set_audio_speed_hint(vo, speed);
+        p->vsync_speed_sent = speed;
+    }
+}
+
+// Host mode: the stamp for a frame mpv planned for target_ns (see "avf vsync
+// snap"). --avfoundation-vsync-snap=measure works out and logs the same
+// stamps without using them.
+static int64_t vsync_snap_frame(struct vo *vo, int64_t target_ns)
+{
+    struct priv *p = vo->priv;
+    int mode = p->opts->vsync_snap;
+    if (mode == AVF_VSYNC_SNAP_NO) {
+        avf_vsync_snap_unlock(&p->vsync_snap);
+        p->vsync_stats.have_prev = false;
+        if (p->vsync_speed_sent) {
+            vo_set_audio_speed_hint(vo, 0);
+            p->vsync_speed_sent = 0;
+        }
+        return target_ns;
+    }
+    vsync_snap_start_clock(p);
+
+    int64_t now = mp_time_ns();
+    struct avf_vsync_stats *st = &p->vsync_stats;
+    vsync_snap_report(vo, now);
+    st->frames++;
+
+    int64_t vsync, period, nominal;
+    if (p->vsync_paused || !vsync_snap_grid(p, now, &vsync, &period, &nominal)) {
+        st->unsnapped++;
+        st->have_prev = false;
+        avf_vsync_snap_unlock(&p->vsync_snap);
+        return target_ns;
+    }
+
+    // Refreshes in the stamps' clock: the layer shows a frame on the first
+    // refresh at which its timebase (mp_time_ns() plus the offset) has
+    // reached the stamp, so a refresh at V is a boundary at V + offset.
+    // (Media mode passes host times it worked out from the timebase itself.)
+    if (p->presentation_host && p->timebase &&
+        (!p->vsync_tb_checked_ns ||
+         now - p->vsync_tb_checked_ns >= MP_TIME_MS_TO_NS(1000)))
+    {
+        int64_t before = mp_time_ns();
+        int64_t tb = cm_time_to_ns(CMTimebaseGetTime(p->timebase));
+        int64_t after = mp_time_ns();
+        p->vsync_tb_offset_ns = tb - (before + (after - before) / 2);
+        p->vsync_tb_checked_ns = now;
+    }
+    avf_phase_add(&st->prep, vsync_mod(now - vsync, period), period);
+    if (p->presentation_host)
+        vsync += p->vsync_tb_offset_ns;
+
+    // While the core resamples the sound to follow the display (and the
+    // servo has room), the picture's offset is held there and no step is
+    // taken by choice.
+    p->vsync_snap.hold = vo_get_audio_speed_applied(vo) && !p->vsync_servo.saturated;
+    p->vsync_snap.picture_early_ns = MP_TIME_MS_TO_NS(p->opts->vsync_snap_sound_late_ms);
+    p->vsync_snap.picture_late_ns = MP_TIME_MS_TO_NS(p->opts->vsync_snap_sound_early_ms);
+    int64_t shown = avf_vsync_snap_refresh(&p->vsync_snap, target_ns, vsync,
+                                           period);
+    int64_t stamp = shown - (int64_t)llround(period * p->opts->vsync_snap_lead);
+    int64_t used = mode == AVF_VSYNC_SNAP_YES ? stamp : target_ns;
+
+    // Diagnostics: where in the refresh the planned time and the stamp the
+    // layer gets fall, and which refresh each frame goes to.
+    st->period_ns = period;
+    st->nominal_ns = nominal;
+    st->frame_one_to_one = p->vsync_snap.frame_ns > 0 &&
+                           fabs(p->vsync_snap.frame_ns - period) * 64 < period;
+    avf_phase_add(&st->planned, vsync_mod(target_ns - vsync, period), period);
+    avf_phase_add(&st->stamped, vsync_mod(used - vsync, period), period);
+    double shift = shown - target_ns;
+    st->shift_sum += shift;
+    st->shift_max = MPMAX(st->shift_max, fabs(shift));
+    st->av_min = st->av_n ? MPMIN(st->av_min, shift) : shift;
+    st->av_max = st->av_n ? MPMAX(st->av_max, shift) : shift;
+    st->av_n++;
+    vsync_snap_servo(vo, mode, period, target_ns);
+
+    // Where each frame lands against its planned time: stamped as planned,
+    // under rule A (the first refresh at or after the stamp) and rule B (the
+    // nearest refresh), and snapped. A frame whose offset changes by 3/4 of a
+    // refresh or more from the frame before it was a refresh early or late
+    // against it: a skip or a repeat. A cadence's own steps (half a refresh
+    // at 24 fps on 60 Hz, 0.6 at 25 on 60) stay under that.
+    int64_t err_a = vsync - target_ns -
+                    avf_vsync_floor_div(vsync - target_ns, period) * period;
+    int64_t err_b = err_a > period / 2 ? err_a - period : err_a;
+    int64_t err_s = shown - target_ns;
+    if (target_ns + err_a != shown)
+        st->moved++;
+    if (st->have_prev && st->prev_relocks == p->vsync_snap.relocks) {
+        int64_t big = period * 3 / 4;
+        st->uneven_a += llabs(err_a - st->prev_err_a) >= big;
+        st->uneven_b += llabs(err_b - st->prev_err_b) >= big;
+        st->uneven_s += llabs(err_s - st->prev_err_s) >= big;
+        // The snap's refreshes, one after the other: a step of one refresh
+        // per frame is one frame each; none, two frames in one refresh; more,
+        // refreshes left without a new frame. (A cadence such as 24 fps on
+        // 60 Hz counts its own longer steps here.)
+        int64_t step = (shown - st->prev_shown + period / 2) / period;
+        if (step == 1)
+            st->occ_one++;
+        else if (step <= 0)
+            st->occ_two++;
+        else
+            st->occ_none += (int)(step - 1);
+    }
+    st->have_prev = true;
+    st->prev_err_a = err_a;
+    st->prev_err_b = err_b;
+    st->prev_err_s = err_s;
+    st->prev_relocks = p->vsync_snap.relocks;
+    st->prev_shown = shown;
+
+    if (p->presentation_host) {
+        p->vsync_frame_snapped = true;
+        p->vsync_frame_planned_ns = target_ns;
+        p->vsync_frame_stamp_ns = used - p->vsync_tb_offset_ns;
+    }
+    return used;
+}
+
+// Sample the frame's luma on a sparse grid and work out what it offers as a
+// place to hide a step (struct avf_step_cand): a cut from the frame before
+// (avf_vsync_quiet_kind), the frame before being black or uniform, and the
+// change a skip or a repeat would make. Every format mpv gives this VO is
+// read: VideoToolbox's 8- and 10-bit biplanar, packed 4:2:2 and RGB
+// outputs, and the software formats query_format() takes. Only a buffer
+// that cannot be locked (or a compressed format nothing here asks for)
+// gives no candidate (counted as unreadable), and a step then waits for the
+// end of the lip-sync range.
+static struct avf_step_cand vsync_frame_candidate(struct vo *vo, struct mp_image *img)
+{
+    struct priv *p = vo->priv;
+    struct avf_step_cand cand = {0};
+    const uint8_t *base = NULL;
+    size_t stride = 0;
+    // A luma sample: `step` bytes per pixel, the value at byte `at` (8 bit)
+    // or as a little-endian 16-bit word shifted right by `shift`.
+    int w = 0, h = 0, step = 0, at = 0, shift = -1;
+    CVPixelBufferRef pb = NULL;
+    if (!img) {
+        p->vsync_grids = 0;
+        return cand;
+    }
+    if (img->imgfmt == IMGFMT_VIDEOTOOLBOX) {
+        pb = (CVPixelBufferRef)img->planes[3];
+        int plane = 0;
+        switch (pb ? CVPixelBufferGetPixelFormatType(pb) : 0) {
+        // 8-bit Y'CbCr, biplanar 4:2:0, 4:2:2, 4:4:4 (what VideoToolbox gives
+        // for 8-bit H.264 and HEVC: FFmpeg asks it for NV12).
+        case kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange:
+        case kCVPixelFormatType_420YpCbCr8BiPlanarFullRange:
+        case kCVPixelFormatType_422YpCbCr8BiPlanarVideoRange:
+        case kCVPixelFormatType_422YpCbCr8BiPlanarFullRange:
+        case kCVPixelFormatType_444YpCbCr8BiPlanarVideoRange:
+        case kCVPixelFormatType_444YpCbCr8BiPlanarFullRange:
+            step = 1;
+            break;
+        // 10-bit, MSB-aligned in 16 bits (10-bit HEVC, HDR10 and Dolby
+        // Vision 5/8: FFmpeg asks for P010), 4:2:0, 4:2:2, 4:4:4.
+        case kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange:
+        case kCVPixelFormatType_420YpCbCr10BiPlanarFullRange:
+        case kCVPixelFormatType_422YpCbCr10BiPlanarVideoRange:
+        case kCVPixelFormatType_422YpCbCr10BiPlanarFullRange:
+        case kCVPixelFormatType_444YpCbCr10BiPlanarVideoRange:
+        case kCVPixelFormatType_444YpCbCr10BiPlanarFullRange:
+            step = 2;
+            shift = 8;
+            break;
+        // Packed 4:2:2: Y in every second byte.
+        case kCVPixelFormatType_422YpCbCr8:         // '2vuy' (UYVY)
+            step = 2;
+            at = 1;
+            break;
+        case kCVPixelFormatType_422YpCbCr8_yuvs:    // 'yuvs' (YUYV)
+            step = 2;
+            break;
+        // RGB: green stands in for luma.
+        case kCVPixelFormatType_32BGRA:
+        case kCVPixelFormatType_32ARGB:
+            step = 4;
+            at = CVPixelBufferGetPixelFormatType(pb) == kCVPixelFormatType_32BGRA ? 1 : 2;
+            break;
+        }
+        // Compressed (lossless/lossy AGX) and other formats are not CPU
+        // readable: FFmpeg never asks VideoToolbox for them.
+        if (step && CVPixelBufferLockBaseAddress(pb, kCVPixelBufferLock_ReadOnly) == kCVReturnSuccess) {
+            bool planar = CVPixelBufferIsPlanar(pb);
+            base = planar ? CVPixelBufferGetBaseAddressOfPlane(pb, plane)
+                          : CVPixelBufferGetBaseAddress(pb);
+            stride = planar ? CVPixelBufferGetBytesPerRowOfPlane(pb, plane)
+                            : CVPixelBufferGetBytesPerRow(pb);
+            w = (int)(planar ? CVPixelBufferGetWidthOfPlane(pb, plane) : CVPixelBufferGetWidth(pb));
+            h = (int)(planar ? CVPixelBufferGetHeightOfPlane(pb, plane) : CVPixelBufferGetHeight(pb));
+        } else {
+            pb = NULL;
+        }
+    } else if (img->imgfmt == IMGFMT_NV12 || img->imgfmt == IMGFMT_420P ||
+               img->imgfmt == IMGFMT_P010 || img->imgfmt == imgfmt_420p10() ||
+               img->imgfmt == imgfmt_420p12()) {
+        // Software decoding (AV1, VP9, anything VideoToolbox does not take).
+        step = img->imgfmt == IMGFMT_NV12 || img->imgfmt == IMGFMT_420P ? 1 : 2;
+        shift = img->imgfmt == IMGFMT_P010 ? 8 : img->imgfmt == imgfmt_420p10() ? 2
+              : img->imgfmt == imgfmt_420p12() ? 4 : -1;
+        base = img->planes[0];
+        stride = img->stride[0] > 0 ? img->stride[0] : 0;
+        w = img->w;
+        h = img->h;
+    }
+    if (!base || !stride || w < AVF_QUIET_GRID_W || h < AVF_QUIET_GRID_H) {
+        if (pb)
+            CVPixelBufferUnlockBaseAddress(pb, kCVPixelBufferLock_ReadOnly);
+        p->vsync_grids = 0;
+        p->vsync_stats.unreadable++;
+        return cand;
+    }
+    enum { N = AVF_QUIET_GRID_W * AVF_QUIET_GRID_H };
+    uint8_t grid[N];
+    double sum = 0, sum2 = 0;
+    for (int y = 0; y < AVF_QUIET_GRID_H; y++) {
+        const uint8_t *row = base + stride * (size_t)((2 * y + 1) * h / (2 * AVF_QUIET_GRID_H));
+        for (int x = 0; x < AVF_QUIET_GRID_W; x++) {
+            const uint8_t *px = row + (size_t)((2 * x + 1) * w / (2 * AVF_QUIET_GRID_W)) * step;
+            uint8_t v = shift < 0 ? px[at]
+                                  : (uint8_t)MPMIN(255, (px[0] | px[1] << 8) >> shift);
+            grid[y * AVF_QUIET_GRID_W + x] = v;
+            sum += v;
+            sum2 += (double)v * v;
+        }
+    }
+    if (pb)
+        CVPixelBufferUnlockBaseAddress(pb, kCVPixelBufferLock_ReadOnly);
+    double mean = sum / N, sd = sqrt(fmax(0, sum2 / N - mean * mean));
+    // vsync_grid[0] is the frame before, [1] the one before that.
+    if (p->vsync_grids >= 2) {
+        double d1 = 0;
+        for (int i = 0; i < N; i++)
+            d1 += abs((int)grid[i] - (int)p->vsync_grid[0][i]);
+        d1 /= N;
+        int kind = avf_vsync_quiet_kind(d1, &p->vsync_typical_diff);
+        cand.valid = true;
+        cand.kind = kind == 1 ? 1 : avf_grid_flat(p->vsync_grid_mean, p->vsync_grid_sd) ? 2 : 0;
+        cand.repeat = avf_grid_score(grid, p->vsync_grid[0], N);
+        cand.skip = avf_grid_score(grid, p->vsync_grid[1], N);
+        struct avf_vsync_stats *st = &p->vsync_stats;
+        st->sampled++;
+        st->cuts += cand.kind == 1;
+        st->flats += cand.kind == 2;
+        st->stills += kind == 2;
+    }
+    memcpy(p->vsync_grid[1], p->vsync_grid[0], N);
+    memcpy(p->vsync_grid[0], grid, N);
+    p->vsync_grid_mean = mean;
+    p->vsync_grid_sd = sd;
+    p->vsync_grids = MPMIN(p->vsync_grids + 1, 2);
+    return cand;
+}
+
+// Host mode, in flip_page: hold a snapped frame until the pacing point of the
+// refresh (see avf_vsync_pace_ns()), then note where its enqueue fell. Called
+// just before the frame goes to the layer (ready_wait: how long flip_page
+// waited for the layer to take more) and, with pace, also at flip_page's start.
+// A frame that comes to the VO too late for its point is held for the next
+// one when that still leaves it this long before its stamp: 20 ms, which is
+// 30 ms before the refresh it is shown on. Going in at once instead put it
+// wherever mpv's schedule was, and on the 1st generation Apple TV 4K that
+// is inside the band that drops frames (half the drops left at its clean
+// point came with an enqueue 14 to 26 ms late).
+#define AVF_VSYNC_PACE_MIN_LEAD_NS MP_TIME_MS_TO_NS(20)
+
+// A video sample never goes to the layer before its pacing point: the wait
+// is aimed early by at most this much of the enqueue's learned lateness (it
+// was up to 8 ms, and a frame aimed early whose enqueue then came quickly
+// went in before the point, so mpv handed over the next one before the
+// point had passed).
+#define AVF_VSYNC_PACE_LATE_MAX_NS 1e6
+
+// Sleep until `at` (mp_time_ns). One long sleep overshoots by milliseconds
+// on an Apple TV (the longer the sleep, the more: enqueues spread -4 to +5
+// ms after 33 ms waits, -2 to +2 after 7 ms ones), so the last stretch is
+// taken in short hops and the last 0.3 ms without sleeping.
+static void vsync_wait_until(int64_t at)
+{
+    for (;;) {
+        int64_t left = at - mp_time_ns();
+        if (left <= 0)
+            return;
+        if (left > MP_TIME_MS_TO_NS(3)) {
+            mp_sleep_ns(left - MPMAX(MP_TIME_MS_TO_NS(2), left / 6));
+        } else if (left > MP_TIME_US_TO_NS(300)) {
+            mp_sleep_ns(MP_TIME_US_TO_NS(150));
+        }
+    }
+}
+
+// The point a device starts from when nothing was saved for it: the middle
+// of what was measured clean on it (see "avf vsync snap": the 1st generation
+// Apple TV 4K takes hand-overs near the display link's instant, the 2nd in
+// the middle of the refresh). Other devices start in the middle and auto
+// pacing moves the point if the layer drops frames there.
+static double vsync_pace_device_default(void)
+{
+#if TARGET_OS_TV
+    char model[64] = {0};
+    size_t size = sizeof(model) - 1;
+    if (sysctlbyname("hw.machine", model, &size, NULL, 0) == 0 &&
+        strcmp(model, "AppleTV6,2") == 0)
+        return 0.05;
+#endif
+    return 0.42;
+}
+
+// --avfoundation-vsync-snap-pace-file (avf_vsync_pace_file_read()): read
+// when the display's mode is first known, rewritten when the point moves or
+// is confirmed, so a device starts each film at the point it found clean.
+static bool vsync_pace_load(struct vo *vo, int64_t period)
+{
+    struct priv *p = vo->priv;
+    const char *path = p->opts->vsync_snap_pace_file;
+    if (!path || !path[0])
+        return false;
+    FILE *f = fopen(path, "r");
+    if (!f)
+        return false;
+    bool found = avf_vsync_pace_file_read(f, period, &p->vsync_pace);
+    fclose(f);
+    return found;
+}
+
+static void vsync_pace_save(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    const char *path = p->opts->vsync_snap_pace_file;
+    if (!path || !path[0] || !p->vsync_pace_period)
+        return;
+    char *tmp = talloc_asprintf(NULL, "%s.tmp", path);
+    FILE *out = fopen(tmp, "w");
+    if (out) {
+        FILE *in = fopen(path, "r");
+        avf_vsync_pace_file_write(in, out, p->vsync_pace_period, &p->vsync_pace);
+        if (in)
+            fclose(in);
+        bool ok = fclose(out) == 0;
+        if (!ok || rename(tmp, path) != 0)
+            unlink(tmp);
+    }
+    talloc_free(tmp);
+}
+
+// The point for this display mode: the option when it is set (again when it
+// is set while playing, which also starts auto's search afresh there), else
+// what was saved for the mode, else the device's default.
+static void vsync_pace_setup(struct vo *vo, int64_t period)
+{
+    struct priv *p = vo->priv;
+    double opt = p->opts->vsync_snap_pace_phase;
+    bool new_mode = !p->vsync_pace_period ||
+                    llabs(period - p->vsync_pace_period) * 200 > p->vsync_pace_period;
+    if (!new_mode && opt == p->vsync_pace_opt)
+        return;
+    p->vsync_pace_period = period;
+    p->vsync_pace_opt = opt;
+    if (opt >= 0) {
+        avf_vsync_pace_start(&p->vsync_pace, opt);
+        p->vsync_pace_origin = "option";
+    } else if (vsync_pace_load(vo, period)) {
+        p->vsync_pace_origin = "file";
+    } else {
+        avf_vsync_pace_start(&p->vsync_pace, vsync_pace_device_default());
+        p->vsync_pace_origin = "default";
+    }
+    MP_VERBOSE(vo, "vsync-snap pace: starting at %.3f, from the %s (refresh %.3f ms)\n",
+               p->vsync_pace.phase, p->vsync_pace_origin, period / 1e6);
+}
+
+static void vsync_pace_wait(struct vo *vo, bool with_osd)
+{
+    struct priv *p = vo->priv;
+    p->vsync_pace_wait_ns = 0;
+    p->vsync_pace_at_ns = 0;
+    p->vsync_pace_video_at_ns = 0;
+    p->vsync_pace_with_osd = with_osd;
+    if (!p->vsync_frame_snapped || p->opts->vsync_snap != AVF_VSYNC_SNAP_YES ||
+        p->opts->vsync_snap_pace == AVF_VSYNC_PACE_NO)
+        return;
+    int64_t now = mp_time_ns(), vsync, period, nominal;
+    if (!vsync_snap_grid(p, now, &vsync, &period, &nominal))
+        return;
+    vsync_pace_setup(vo, period);
+    // Aimed early by how late the video enqueue has been after the point
+    // (the readiness check; at most AVF_VSYNC_PACE_LATE_MAX_NS), and on a
+    // frame that carries an OSD sample ahead of the video's
+    // (--avfoundation-osd-after-video=no) by what that sample's enqueue
+    // takes; the video sample itself then still waits for the point
+    // (vsync_pace_hold_video()).
+    int64_t late = (int64_t)fmin(p->vsync_pace_late_ns, AVF_VSYNC_PACE_LATE_MAX_NS);
+    int64_t early = late + (with_osd ? (int64_t)p->vsync_osd_enqueue_ns : 0);
+    int64_t phase = (int64_t)llround(period * p->vsync_pace.phase) - early;
+    int64_t at = avf_vsync_pace_ns(now, p->vsync_frame_stamp_ns, vsync, period,
+                                   phase, AVF_VSYNC_PACE_MIN_LEAD_NS);
+    // One frame per slot (avf_vsync_pace_slot_ns()), at one frame per refresh.
+    if (p->vsync_pace_slot_phase == p->vsync_pace.phase &&
+        avf_vsync_one_to_one(&p->vsync_snap, (double)period))
+    {
+        at = avf_vsync_pace_slot_ns(now, at, p->vsync_pace_slot_ns, period, early,
+                                    p->vsync_frame_stamp_ns,
+                                    AVF_VSYNC_PACE_MIN_LEAD_NS);
+    }
+    p->vsync_pace_slot_ns = at > now ? at + early : 0;
+    p->vsync_pace_slot_phase = p->vsync_pace.phase;
+    p->vsync_pace_video_at_ns = at > now ? at + early - late : 0;
+    // Lateness is learned from frames without an OSD sample only.
+    p->vsync_pace_at_ns = at > now && !with_osd ? at + late : 0;
+    if (at > now) {
+        vsync_wait_until(at);
+        p->vsync_pace_wait_ns = at - now;
+    }
+}
+
+// With the OSD sample enqueued ahead of the video's, the wait was aimed
+// early by what that enqueue takes on average; when it was quicker, the video
+// sample still waits for its point rather than go in before it.
+static void vsync_pace_hold_video(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    if (p->vsync_frame_snapped && p->vsync_pace_video_at_ns)
+        vsync_wait_until(p->vsync_pace_video_at_ns);
+}
+
+static void vsync_note_enqueue(struct vo *vo, int64_t ready_wait_ns)
+{
+    struct priv *p = vo->priv;
+    if (!p->vsync_frame_snapped)
+        return;
+    p->vsync_frame_snapped = false;
+    struct avf_vsync_stats *st = &p->vsync_stats;
+    int64_t now = mp_time_ns(), vsync, period, nominal;
+    if (!vsync_snap_grid(p, now, &vsync, &period, &nominal))
+        return;
+    avf_phase_add(&st->enqueued, vsync_mod(now - vsync, period), period);
+    if (p->vsync_pace_at_ns) {
+        double late = (double)(now - p->vsync_pace_at_ns);
+        late = fmax(-2e6, fmin(10e6, late));
+        p->vsync_pace_late_ns = fmax(0, fmin(AVF_VSYNC_PACE_LATE_MAX_NS,
+                                             p->vsync_pace_late_ns + late / 16));
+        p->vsync_pace_at_ns = 0;
+    }
+    double lead = p->vsync_frame_stamp_ns - now;
+    st->lead_min = st->enq ? MPMIN(st->lead_min, lead) : lead;
+    st->lead_max = st->enq ? MPMAX(st->lead_max, lead) : lead;
+    st->lead_sum += lead;
+    st->pace_sum += p->vsync_pace_wait_ns;
+    st->pace_max = MPMAX(st->pace_max, p->vsync_pace_wait_ns);
+    st->ready_sum += ready_wait_ns;
+    st->ready_max = MPMAX(st->ready_max, ready_wait_ns);
+    st->enq++;
+}
+
+// Media mode: the layer shows a frame when its media timebase reaches the
+// frame's media PTS. The timebase runs at the servo's rate from its anchor,
+// so the host time that happens at is known; that host time is snapped as in
+// host mode and mapped back through the same timebase. The servo's rate
+// changes (100 ppm steps, at most every 200 ms) move it by microseconds over
+// a queue lead. Not before the timebase is anchored and running: the first
+// frame after a reset, a pause or a re-anchor keeps its PTS.
+static void vsync_snap_media_frame(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+    double rate = p->timebase_applied_rate;
+    if (!p->timebase || !p->timebase_anchor_valid || p->playback_paused ||
+        !(rate > 0.0))
+    {
+        avf_vsync_snap_unlock(&p->vsync_snap);
+        p->vsync_stats.have_prev = false;
+        return;
+    }
+    int64_t before = mp_time_ns();
+    int64_t tb = cm_time_to_ns(CMTimebaseGetTime(p->timebase));
+    int64_t after = mp_time_ns();
+    int64_t now = before + (after - before) / 2;
+    int64_t target = now + (int64_t)llround((p->next_media_pts_ns - tb) / rate);
+    int64_t stamp = vsync_snap_frame(vo, target);
+    if (stamp != target) {
+        p->next_media_stamp_ns = p->next_media_pts_ns +
+                                 (int64_t)llround((stamp - target) * rate);
+        p->next_media_stamp_valid = true;
+    }
+}
