+// --avfoundation-vsync-snap: stamps placed inside their refresh (yes), left
+// as planned but logged as if placed (measure), or neither (no).
+enum avf_vsync_snap_mode {
+    AVF_VSYNC_SNAP_NO = 0,
+    AVF_VSYNC_SNAP_YES = 1,
+    AVF_VSYNC_SNAP_MEASURE = 2,
+};
+
+// --avfoundation-vsync-snap-pace: with the snap on, frames go to the layer
+// at a fixed point of the refresh (yes), at a point that moves on when the
+// layer reports drops (auto), or whenever mpv's schedule says (no).
+enum avf_vsync_pace_mode {
+    AVF_VSYNC_PACE_NO = 0,
+    AVF_VSYNC_PACE_YES = 1,
+    AVF_VSYNC_PACE_AUTO = 2,
 };
 
 // --- avf sync servo core (host-testable; keep freestanding) ---
@@ -476,6 +499,660 @@ static double avf_servo_rate(int64_t error_ns, double nominal_rate,
 }
 // --- end avf sync servo core ---
 
+// --- avf vsync snap (host-testable; keep freestanding) ---
+// Host mode stamps each frame with mpv's planned display time, which follows
+// the audio clock (with passthrough, the HDMI audio clock) and carries the
+// container's timestamp rounding (Matroska: 1 ms, so a 23.976 fps film's
+// planned times sit up to 0.5 ms off an even 41.708 ms grid). The VO also
+// does its per-frame work at times set by that clock: mpv hands it each frame
+// about queue-lead-ms before the planned time, and it enqueues the frame then.
+// Measured on two Apple TVs with a 23.976 fps film on a 23.976 Hz mode, the
+// layer drops frames by its own count (AVVideoPerformanceMetrics: 10 to 25%
+// of them, a visible stutter, with every mpv counter at zero) while that work
+// falls in one part of the refresh, and none outside it:
+//   - Apple TV 4K (1st generation), stamps as planned: drops while planned
+//     times sat 21 to 36 ms past the display link's refresh instant, almost
+//     none from 0 to 20. With every stamp 31.3 ms past the instant, none
+//     with planned times at 22 ms, 7% with them at 28 ms.
+//   - Apple TV 4K (2nd generation), every stamp 31.3 ms past the instant:
+//     its audio clock ran 14 ppm off the refresh, so the planned times swept
+//     the whole refresh every 49 minutes, and the layer dropped frames for the
+//     ~6 minutes of each sweep in which they sat from ~7 ms before the instant
+//     to ~2 ms after it, none elsewhere; the stamps never moved.
+// The stamp's place in the refresh is therefore not what decides it. The
+// reading that fits both (a hypothesis: the layer's internals are not
+// documented) is that an enqueue (about 119 ms ahead of the planned time)
+// landing in the ~10 ms before the display takes its next frame costs a
+// frame: that is 30 to 40 ms past the instant on the first, 40 to 8 on the
+// second, and enqueues from ~9 to ~27 ms past it were clean on both.
+//
+// So the VO decides each frame's refresh itself and keeps both its stamp and
+// its enqueue at fixed points of the refresh, never where the audio clock
+// happens to put them. The refresh is picked with hysteresis: lock_ns is the
+// smoothed offset of planned times from the refreshes they are shown on, and
+// every frame goes to the refresh that keeps its own offset within half a
+// refresh of it, so jitter of up to a quarter refresh (in a cadence like 24
+// fps on 60 Hz, the spread of the cadence's phases plus the jitter) never
+// changes a frame's refresh. The stamp is a fixed share of a refresh
+// (--avfoundation-vsync-snap-lead) before that refresh, whatever the lock;
+// the enqueue waits for a fixed point of the refresh
+// (--avfoundation-vsync-snap-pace-phase, avf_vsync_pace_ns()). When the audio
+// clock drifts against the refresh, lock_ns follows, and a whole frame of
+// drift has to become one repeat or skip. The audio clock is not slaved to
+// the refresh even over HDMI (audio is sent with N/CTS against the TMDS
+// clock, which lets them differ): on the 2nd generation Apple TV the audio
+// ran with the host clock (+0.3 ppm) and the 23.976 Hz refresh 14 ppm slow
+// (a frame every 49 minutes); on the 1st both were within 0.5 ppm of the
+// host clock and nothing drifted. Decoded (PCM) audio is resampled to
+// follow the display instead (avf_av_servo_update(); the core applies it),
+// so there the picture never steps. Passthrough cannot be resampled: the
+// picture may drift within a lip-sync range (AVF_AV_*_PICTURE_NS, wider on
+// the side people notice least), the step can be taken anywhere in the
+// stretch where it keeps the picture in range, and avf_step_choice() puts
+// it on a cut, a fade through black, a still picture or, failing those in
+// a long pan, the calmest frame lately (struct avf_step_cand). Cadences
+// (24 fps on 60 Hz) hide their 2,3 slips the same way. A new lock (the
+// first frame after a seek, a pause, a mode change, or refreshes that moved
+// by part of one, as when a window goes to another display) takes the
+// refresh nearest the frame (at one frame per refresh, the one nearest the
+// middle of the lip-sync range); while it is young
+// (AVF_VSYNC_SNAP_ALPHA_DIV frames) it averages the frames' offsets and does
+// not move by whole refreshes, so a cadence's first frames may hold one
+// refresh more or less while it settles.
+// What a frame offers as a place to hide a step (the caller fills it in for
+// every frame from a sparse luma grid; see vsync_frame_candidate()).
+//   kind:   0 nothing special, 1 a hard cut from the frame before, 2 the
+//           frame before is black or uniform (a fade through black);
+//   skip:   how much the picture changes if the frame before is never
+//           shown (difference between the frame two back and this one);
+//   repeat: how much it changes if the frame before is shown twice
+//           (difference between it and this one).
+// Differences are mean absolute 8-bit luma steps over the grid; valid is
+// false when the frame could not be read (then only a forced step remains).
+struct avf_step_cand {
+    bool valid;
+    int kind;
+    double skip, repeat;
+};
+
+enum {
+    AVF_STEP_NONE = 0,
+    AVF_STEP_CUT = 1,
+    AVF_STEP_BLACK = 2,
+    AVF_STEP_STILL = 3,     // score at or under AVF_STEP_STILL_MAX
+    AVF_STEP_LOW = 4,       // the lowest motion seen lately
+    AVF_STEP_FORCED = 5,    // the lip-sync budget ran out
+};
+
+struct avf_vsync_snap {
+    bool locked;
+    int64_t period_ns;      // refresh period the lock was taken with
+    double lock_ns;         // smoothed (planned - shown) offset
+    int frames;             // frames since the lock, for the warm-up mean
+    int64_t last_target_ns;
+    int64_t grid_ns;        // a refresh of the grid the lock was made on
+    int relocks;            // diagnostics: locks taken
+    int reslots;            // diagnostics: whole-refresh moves of the lock
+    // In, per frame: what it offers as a hiding place for a step, and
+    // whether only a step forced by the lip-sync range may be taken (while
+    // the sound is resampled to follow the display, the offset is held).
+    struct avf_step_cand cand;
+    bool hold;
+    // In: the lip-sync range (ns the picture may be early, i.e. the sound
+    // late, and late, i.e. the sound early); 0 takes the defaults.
+    int64_t picture_early_ns, picture_late_ns;
+    double frame_ns;        // smoothed spacing of planned times
+    // Drift of shown minus planned, ms per s of planned time (+: the
+    // picture falls behind, a skip will be needed; -: a repeat), measured
+    // over 10 s spans; kept across locks while the refresh period holds.
+    double drift;
+    int64_t drift_t0;
+    double drift_l0;
+    double drift_raw;       // spans' running estimate, before it is trusted
+    int drift_spans;        // spans in a row of the same sign
+    // Lowest step score seen lately (rises slowly), per direction.
+    double best_skip, best_repeat;
+    // Diagnostics: steps by kind, and the last one.
+    int steps_by_kind[6];
+    int last_kind;
+    double last_score, last_av_ns;
+};
+
+#define AVF_VSYNC_SNAP_HYST_DIV 16
+#define AVF_VSYNC_SNAP_ALPHA_DIV 32
+// Planned times further apart than this (a stall, a skipped stretch) start
+// a new lock rather than carry the old phase over.
+#define AVF_VSYNC_SNAP_GAP_NS INT64_C(1000000000)
+// Lip sync: how far the picture may be shown after the sound it belongs to
+// (sound early) and before it (sound late). ITU-R BT.1359 puts the
+// threshold of detection at sound 45 ms early and 125 ms late, and EBU R37
+// asks a broadcast chain to keep within sound 40 ms early and 60 ms late;
+// these stay inside both, on the side people notice least.
+#define AVF_AV_LATE_PICTURE_NS  INT64_C(25000000)   // sound early by up to 25 ms
+#define AVF_AV_EARLY_PICTURE_NS INT64_C(60000000)   // sound late by up to 60 ms
+// A step is a still frame's when its score is at most this, and the
+// drift's direction is trusted when it is over this many ms per s (4 ppm).
+#define AVF_STEP_STILL_MAX 0.6
+#define AVF_DRIFT_MIN 0.004
+
+static int64_t avf_vsync_floor_div(int64_t a, int64_t b)
+{
+    int64_t q = a / b;
+    if (a % b != 0 && a < 0)
+        q--;
+    return q;
+}
+
+// Forget the lock: the next frame goes to the refresh nearest its planned
+// time (or, at one frame per refresh, the one nearest the middle of the
+// lip-sync range) and the phase is learned again. A seek, a pause or a lost
+// refresh clock calls it.
+static void avf_vsync_snap_unlock(struct avf_vsync_snap *s)
+{
+    s->locked = false;
+}
+
+static bool avf_vsync_one_to_one(const struct avf_vsync_snap *s, double period)
+{
+    return s->frame_ns > 0 && fabs(s->frame_ns - period) * 64 < period;
+}
+
+// Whether to take the step on this frame, which would move the picture by
+// one refresh in direction dir (+1: a skip, the picture falls behind; -1: a
+// repeat). b is how much of the stretch in which the step keeps the picture
+// in range is used (0: the step has just become possible, 1: it is due).
+// In the first half of the stretch nothing is taken, so the picture keeps
+// near the middle of its lip-sync range on average. From there a cut or a
+// fade through black takes it at once, and a still picture too; from
+// three quarters on, a frame whose change is no more than the lowest seen
+// lately (by up to half again as the stretch runs out), so a step that has
+// to fall in a long pan still falls on its calmest frame. Scores measure how
+// much of the picture changes (avf_grid_score), so a frame where only a
+// small part moves ranks above a slow pan where everything does. At 1 the
+// step is taken whatever the frame (forced).
+static int avf_step_choice(struct avf_vsync_snap *s, int dir, double b,
+                           double *score)
+{
+    const struct avf_step_cand *c = &s->cand;
+    *score = -1;
+    if (!c->valid)
+        return b >= 1 ? AVF_STEP_FORCED : AVF_STEP_NONE;
+    *score = dir > 0 ? c->skip : c->repeat;
+    if (b >= 1)
+        return AVF_STEP_FORCED;
+    if (b < 0.5)
+        return AVF_STEP_NONE;
+    if (c->kind == 1)
+        return AVF_STEP_CUT;
+    if (c->kind == 2)
+        return AVF_STEP_BLACK;
+    if (*score <= AVF_STEP_STILL_MAX)
+        return AVF_STEP_STILL;
+    double best = dir > 0 ? s->best_skip : s->best_repeat;
+    if (b >= 0.75 && best > 0 && *score <= best * (1 + 2 * (b - 0.75)))
+        return AVF_STEP_LOW;
+    return AVF_STEP_NONE;
+}
+
+static void avf_step_note_scores(struct avf_vsync_snap *s)
+{
+    const struct avf_step_cand *c = &s->cand;
+    if (!c->valid || c->kind)
+        return;
+    // A minimum that forgets slowly: up by e every 5 minutes of 24 fps.
+    s->best_skip = s->best_skip > 0 ? fmin(c->skip, s->best_skip * (1 + 1.0 / 7200))
+                                    : c->skip;
+    s->best_repeat = s->best_repeat > 0
+        ? fmin(c->repeat, s->best_repeat * (1 + 1.0 / 7200)) : c->repeat;
+}
+
+// The refresh (an instant on the grid vsync_ns + k * period_ns) that the frame
+// planned for target_ns is shown on. vsync_ns is any refresh instant in the
+// stamps' clock. period_ns <= 0 means no grid: target_ns comes back.
+static int64_t avf_vsync_snap_refresh(struct avf_vsync_snap *s,
+                                      int64_t target_ns, int64_t vsync_ns,
+                                      int64_t period_ns)
+{
+    if (period_ns <= 0) {
+        s->locked = false;
+        return target_ns;
+    }
+    const double period = (double)period_ns;
+    // Planned time past the refresh at or before it, in [0, period).
+    int64_t off = target_ns - vsync_ns;
+    off -= avf_vsync_floor_div(off, period_ns) * period_ns;
+
+    int64_t dperiod = period_ns - s->period_ns;
+    if (dperiod < 0)
+        dperiod = -dperiod;
+    bool new_period = dperiod * 500 > s->period_ns;
+    // The grid moved under the lock (a window taken to another display of
+    // the same rate, a display that changed its timing): its refreshes are
+    // no longer where the lock's were.
+    int64_t moved = s->locked ? vsync_ns - s->grid_ns : 0;
+    moved -= avf_vsync_floor_div(moved, period_ns) * period_ns;
+    if (moved > period_ns / 2)
+        moved = period_ns - moved;
+    s->grid_ns = vsync_ns;
+    // The picture's lip-sync range, as lock_ns (planned - shown) values.
+    const double lo = -(double)(s->picture_late_ns > 0 ? s->picture_late_ns
+                                                       : AVF_AV_LATE_PICTURE_NS);
+    const double hi = (double)(s->picture_early_ns > 0 ? s->picture_early_ns
+                                                      : AVF_AV_EARLY_PICTURE_NS);
+    if (!s->locked || new_period || moved * 8 > period_ns ||
+        target_ns <= s->last_target_ns ||
+        target_ns - s->last_target_ns > AVF_VSYNC_SNAP_GAP_NS)
+    {
+        if (new_period) {
+            s->frame_ns = 0;
+            s->drift = s->drift_raw = 0;
+            s->drift_spans = 0;
+            s->best_skip = s->best_repeat = 0;
+        }
+        // New lock: the nearest refresh, offset in (-period/2, period/2];
+        // at one frame per refresh (known from before this lock), the
+        // refresh that puts the picture nearest the middle of its lip-sync
+        // range, which leaves the most room for drift either way.
+        s->locked = true;
+        s->period_ns = period_ns;
+        s->lock_ns = off > period_ns / 2 ? off - period_ns : off;
+        if (avf_vsync_one_to_one(s, period)) {
+            double mid = (lo + hi) / 2;
+            s->lock_ns += period * floor((mid - s->lock_ns) / period + 0.5);
+        }
+        s->frames = 0;
+        s->drift_t0 = 0;
+        s->relocks++;
+    } else {
+        double d = (double)(target_ns - s->last_target_ns);
+        s->frame_ns = s->frame_ns > 0 ? s->frame_ns + (d - s->frame_ns) / 16 : d;
+    }
+    s->last_target_ns = target_ns;
+
+    bool young = s->frames < AVF_VSYNC_SNAP_ALPHA_DIV;
+    // The drift, from the lock over 10 s spans once it has settled (240
+    // frames after it was taken). One span's noise is about 5 ppm, so a
+    // small drift is trusted after three spans in a row agree; a big one
+    // (over 50 ppm: 24 fps on 23.976 Hz is 1001) at once.
+    if (s->frames >= 240) {
+        if (!s->drift_t0) {
+            s->drift_t0 = target_ns;
+            s->drift_l0 = s->lock_ns;
+        } else if (target_ns - s->drift_t0 >= INT64_C(10000000000)) {
+            double rate = -(s->lock_ns - s->drift_l0) /
+                          ((target_ns - s->drift_t0) / 1e9) / 1e6;   // ms/s
+            bool same = (rate > 0) == (s->drift_raw > 0);
+            s->drift_spans = same ? s->drift_spans + 1 : 1;
+            s->drift_raw = s->drift_raw && same ? s->drift_raw + (rate - s->drift_raw) / 4
+                                                : rate;
+            if (s->drift_spans >= 3 || fabs(rate) > 0.05)
+                s->drift = s->drift_raw;
+            s->drift_t0 = target_ns;
+            s->drift_l0 = s->lock_ns;
+        }
+    }
+
+    // The step. The display shows a frame per refresh at its own rate and
+    // the sound plays at the audio clock's; where they differ (an Apple TV's
+    // 23.976 Hz mode measured 14 ppm slow against its audio, so a frame every
+    // 49 minutes), a frame has to be skipped or repeated now and then. The
+    // picture may drift within its lip-sync range (lo..hi) meanwhile, so
+    // the step can be taken anywhere in the stretch where it keeps the
+    // picture in range afterwards: two refreshes' worth of range less the
+    // step, 45 minutes at 14 ppm. avf_step_choice() picks the frame in that
+    // stretch; past the range the step is taken on the next frame anyway.
+    // It is applied before this frame's refresh is picked, so it falls
+    // between the frame before and this one.
+    if (!young) {
+        double av = -s->lock_ns;                // shown - planned
+        double span = -lo + hi - period;        // the stretch a step may use
+        double b_skip = (av - period + hi) / span;
+        double b_rep = (-lo - period - av) / span;
+        // The direction: the measured drift's. Without one (clocks locked,
+        // or not measured yet) no step is taken by choice, so locked clocks
+        // never step; a drift too small to measure reaches the end of the
+        // range only after hours (6 at 4 ppm).
+        int dir = s->drift > AVF_DRIFT_MIN ? 1 : s->drift < -AVF_DRIFT_MIN ? -1 : 0;
+        int kind = AVF_STEP_NONE;
+        double score = -1;
+        if (av > -lo) {
+            dir = 1;
+            kind = avf_step_choice(s, 1, 1, &score);
+        } else if (av < -hi) {
+            dir = -1;
+            kind = avf_step_choice(s, -1, 1, &score);
+        } else if (s->hold || span <= 0) {
+            // no step by choice
+        } else if (dir > 0 && b_skip >= 0) {
+            kind = avf_step_choice(s, 1, b_skip, &score);
+        } else if (dir < 0 && b_rep >= 0) {
+            kind = avf_step_choice(s, -1, b_rep, &score);
+        }
+        if (kind != AVF_STEP_NONE) {
+            s->lock_ns += dir > 0 ? period : -period;
+            s->drift_l0 += dir > 0 ? period : -period;
+            s->reslots++;
+            s->steps_by_kind[kind]++;
+            s->last_kind = kind;
+            s->last_score = score;
+            s->last_av_ns = av;
+        }
+    }
+    avf_step_note_scores(s);
+
+    // This frame's offset, taken within half a refresh of the lock.
+    int64_t k = (int64_t)floor((off - s->lock_ns) / period + 0.5);
+    int64_t r = off - k * period_ns;
+    // A frame near half a refresh from the lock could go to either refresh.
+    // That happens while a lock is young and has seen too few frames of a
+    // cadence to sit in the middle of their phases (the second frame of 24
+    // fps on 60 Hz is exactly half a refresh from the first): such a frame
+    // goes to the refresh nearer its planned time, which keeps the young
+    // lock inside its range instead of moving it a whole refresh.
+    if (young && fabs(r - s->lock_ns) > period * 7 / 16) {
+        int64_t other = r > s->lock_ns ? r - period_ns : r + period_ns;
+        if (llabs(other) < llabs(r))
+            r = other;
+    }
+
+    s->frames++;
+    int div = s->frames < AVF_VSYNC_SNAP_ALPHA_DIV ? s->frames
+                                                    : AVF_VSYNC_SNAP_ALPHA_DIV;
+    s->lock_ns += (r - s->lock_ns) / div;
+    if (young) {
+        // A young lock is still finding the middle of a cadence's phases;
+        // moving it a whole refresh then would be a skip or repeat of its own.
+        s->lock_ns = fmax(lo, fmin(hi, s->lock_ns));
+    }
+    return target_ns - r;
+}
+
+// When the VO hands the layer a frame stamped stamp_ns, at the earliest now_ns:
+// the next instant phase_ns past a refresh of the grid (vsync_ns + k *
+// period_ns), so every enqueue falls at the same point of the refresh however
+// mpv's schedule drifts against it. A wait that would leave the frame less
+// than min_lead_ns before its stamp is not made (now_ns comes back), nor is
+// one without a grid. The wait is under one refresh and changes nothing the
+// screen shows: the stamp alone decides the frame's refresh.
+static int64_t avf_vsync_pace_ns(int64_t now_ns, int64_t stamp_ns,
+                                 int64_t vsync_ns, int64_t period_ns,
+                                 int64_t phase_ns, int64_t min_lead_ns)
+{
+    if (period_ns <= 0)
+        return now_ns;
+    int64_t off = now_ns - vsync_ns - phase_ns;
+    off -= avf_vsync_floor_div(off, period_ns) * period_ns;  // [0, period)
+    int64_t at = off ? now_ns + (period_ns - off) : now_ns;
+    return stamp_ns - at < min_lead_ns ? now_ns : at;
+}
+
+// --avfoundation-vsync-snap-pace=auto: the enqueue point moves on by a quarter
+// refresh after two 5 s windows in a row in which the layer dropped frames
+// (at least AVF_VSYNC_PACE_BAD_DROPS, and 2% of what it showed). Moving it
+// shows nothing on screen (the stamps stay); it only stops an enqueue point
+// that a display with another timing than the two measured ones does not
+// take. Clean playback drops none in minutes.
+struct avf_vsync_pace {
+    double phase;           // enqueue point, share of a refresh past it
+    int bad_windows;
+    int steps;
+};
+
+#define AVF_VSYNC_PACE_BAD_DROPS 3
+#define AVF_VSYNC_PACE_MIN_FRAMES 48
+
+// One window of the layer's own counts; true when the point moved.
+static bool avf_vsync_pace_judge(struct avf_vsync_pace *s, int64_t shown,
+                                 int64_t dropped)
+{
+    if (shown + dropped < AVF_VSYNC_PACE_MIN_FRAMES)
+        return false;
+    bool bad = dropped >= AVF_VSYNC_PACE_BAD_DROPS &&
+               dropped * 50 >= shown + dropped;
+    s->bad_windows = bad ? s->bad_windows + 1 : 0;
+    if (s->bad_windows < 2)
+        return false;
+    s->bad_windows = 0;
+    s->phase += 0.25;
+    if (s->phase >= 1.0)
+        s->phase -= 1.0;
+    s->steps++;
+    return true;
+}
+
+// Whether a frame is one a repeat or skip can hide in, from the mean
+// absolute difference (diff, in 8-bit luma steps over a sparse grid) between
+// it and the frame before: a hard cut (far above the recent typical
+// difference, *typical, which this updates) or a still picture (no change
+// beyond the encoder's noise). 1: cut, 2: still, 0: neither.
+#define AVF_QUIET_CUT_MIN 12.0
+#define AVF_QUIET_CUT_RATIO 4.0
+#define AVF_QUIET_STILL_MAX 0.6
+
+static int avf_vsync_quiet_kind(double diff, double *typical)
+{
+    int kind = 0;
+    if (*typical > 0 && diff >= AVF_QUIET_CUT_MIN &&
+        diff >= *typical * AVF_QUIET_CUT_RATIO)
+        kind = 1;
+    else if (diff <= AVF_QUIET_STILL_MAX)
+        kind = 2;
+    // A cut does not count towards what is typical.
+    if (kind != 1)
+        *typical = *typical > 0 ? *typical + (diff - *typical) / 16 : fmax(diff, 0.1);
+    return kind;
+}
+
+// The display's refresh period from its link's timestamps: measured over a
+// run of them once it spans 12 refreshes, exact to nanoseconds over a long
+// run. A change of the link's own interval (a mode change: 23.976 to 60 Hz
+// and back when the TV sleeps and wakes) starts a new run and forgets the
+// old period. A gap (the link stopped while the app was in the background
+// or the display asleep, or the main thread stalled) keeps the run if the
+// timestamps still fall on its grid; if they came back at another phase,
+// a new run starts but the period measured before stays published until
+// the new run has its own, so the snap never loses its grid to a gap.
+// Returns the period, or (before any measurement) the link's interval when
+// interval_ok, else 0.
+struct avf_refresh_run {
+    int64_t start, nominal, last, period;
+};
+
+static int64_t avf_refresh_measure(struct avf_refresh_run *r, int64_t vsync,
+                                   int64_t nominal, bool interval_ok)
+{
+    if (nominal <= 0)
+        return 0;
+    if (!r->start || vsync <= r->last ||
+        llabs(nominal - r->nominal) * 200 > r->nominal)
+    {
+        bool same_mode = r->nominal && llabs(nominal - r->nominal) * 200 <= r->nominal;
+        *r = (struct avf_refresh_run){
+            .start = vsync, .nominal = nominal, .last = vsync,
+            .period = same_mode ? r->period : 0,
+        };
+    } else {
+        int64_t est = r->period ? r->period : nominal;
+        if (vsync - r->last > est * 5 / 2) {
+            // A gap: still on the run's grid?
+            int64_t span = vsync - r->start;
+            int64_t n = (span + est / 2) / est;
+            if (llabs(span - n * est) * 8 > est)
+                r->start = vsync;   // another phase: a new run, period kept
+        }
+        int64_t span = vsync - r->start;
+        int64_t n = (span + nominal / 2) / nominal;
+        if (n >= 12) {
+            int64_t measured = (span + n / 2) / n;
+            if (llabs(measured - nominal) * 100 <= nominal)
+                r->period = measured;
+            else
+                r->start = vsync;
+        }
+        r->last = vsync;
+    }
+    return r->period ? r->period : interval_ok ? nominal : 0;
+}
+
+// How much of the picture changes between two luma grids: the 75th
+// percentile of the per-cell absolute differences (8-bit steps). A slow pan
+// moves every cell a little and scores what each cell moved; a static shot
+// with a person talking moves a few cells a lot and scores the noise of the
+// rest. A step in the first is the classic visible judder; in the second it
+// is not seen.
+static double avf_grid_score(const uint8_t *a, const uint8_t *b, int n)
+{
+    int hist[256] = {0};
+    for (int i = 0; i < n; i++)
+        hist[abs((int)a[i] - (int)b[i])]++;
+    int want = n - n / 4, seen = 0;
+    for (int v = 0; v < 256; v++) {
+        seen += hist[v];
+        if (seen >= want)
+            return v;
+    }
+    return 255;
+}
+
+// A frame of the grid is black or uniform (the middle of a fade through
+// black, a title card's background): nothing moves in it to show a step.
+static bool avf_grid_flat(double mean, double sd)
+{
+    return sd <= 1.5 || (mean <= 24 && sd <= 4);
+}
+
+// Decoded (PCM) audio at one frame per refresh: rather than step a frame
+// now and then, play the sound faster or slower by the clocks' mismatch so
+// the picture never has to. The core resamples it (as for mpv's
+// display-resample; 14 ppm is 0.02 cents of pitch). This servo turns the
+// picture's offset from its planned time (av_ms, shown - planned) into that
+// speed, holding the offset at zero: the integral finds the mismatch, the
+// proportional part pulls a fresh lock in over about a minute. Its output is
+// capped at max_ppm; a bigger mismatch (24 fps on a 23.976 Hz mode is 1001
+// ppm) is left to the steps. dt_s is the time since the last call.
+struct avf_av_servo {
+    double integ;           // ms * s
+    double speed;           // last output, 1 = as recorded
+    bool saturated;         // at the cap: the steps must take the rest
+    double saturated_s;     // how long it has been at the cap
+    bool gave_up;           // a mismatch past the cap: steps only
+};
+
+// After this long at the cap the mismatch is taken to be past it (24 fps on
+// a 23.976 Hz mode): resampling stops and the steps hide it all, rather
+// than resampling and stepping fighting over the picture's offset.
+#define AVF_SERVO_GIVE_UP_S 60
+
+#define AVF_SERVO_KP 3.3e-5     // speed per ms of offset
+#define AVF_SERVO_KI 2.8e-7     // speed per ms*s of offset
+
+static double avf_av_servo_update(struct avf_av_servo *v, double av_ms,
+                                  double dt_s, double max_ppm)
+{
+    double cap = max_ppm * 1e-6;
+    if (v->gave_up) {
+        v->saturated = true;
+        v->speed = 1;
+        return v->speed;
+    }
+    if (dt_s > 0 && dt_s < 1) {
+        v->integ += av_ms * dt_s;
+        // No wind-up past what the cap can use.
+        double lim = cap / AVF_SERVO_KI;
+        v->integ = fmax(-lim, fmin(lim, v->integ));
+    }
+    double u = AVF_SERVO_KP * av_ms + AVF_SERVO_KI * v->integ;
+    // av > 0: the picture is behind, so the sound (and with it mpv's
+    // schedule) must slow down.
+    v->saturated = fabs(u) >= cap * 0.98;
+    // Time at the cap, forgotten four times slower than it builds, so a
+    // servo swung from one cap to the other by steps still counts.
+    if (dt_s > 0 && dt_s < 1)
+        v->saturated_s = fmax(0, v->saturated_s + (v->saturated ? dt_s : -dt_s / 4));
+    if (v->saturated_s >= AVF_SERVO_GIVE_UP_S) {
+        v->gave_up = true;
+        v->speed = 1;
+        return v->speed;
+    }
+    v->speed = 1 - fmax(-cap, fmin(cap, u));
+    return v->speed;
+}
+// --- end avf vsync snap ---
+
+// Where in the refresh a set of instants fell: their mean offset past the
+// refresh instant and their spread around it, taken against the window's
+// first one so that a phase near the instant does not wrap.
+struct avf_phase_stat {
+    int n;
+    double ref, sum, lo, hi;
+};
+
+// x and ref are offsets in [0, period); the result in (-period/2, period/2].
+static double avf_phase_diff(double x, double ref, double period)
+{
+    double d = fmod(x - ref, period);
+    if (d > period / 2)
+        d -= period;
+    if (d <= -period / 2)
+        d += period;
+    return d;
+}
+
+static void avf_phase_add(struct avf_phase_stat *s, double x, double period)
+{
+    if (!s->n) {
+        s->ref = x;
+        s->lo = s->hi = 0;
+    }
+    double d = avf_phase_diff(x, s->ref, period);
+    s->sum += d;
+    s->lo = MPMIN(s->lo, d);
+    s->hi = MPMAX(s->hi, d);
+    s->n++;
+}
+
+// Mean offset in [0, period), and the extremes as signed distances from it.
+static void avf_phase_get(const struct avf_phase_stat *s, double period,
+                          double *avg, double *lo, double *hi)
+{
+    double m = s->n ? s->sum / s->n : 0;
+    *avg = fmod(s->ref + m + period, period);
+    *lo = s->lo - m;
+    *hi = s->hi - m;
+}
+
+#define AVF_QUIET_GRID_W 32
+#define AVF_QUIET_GRID_H 18
+
+// The vsync snap's pacing lines, logged every 5 s (vsync_snap_report).
+struct avf_vsync_stats {
+    int64_t window_start_ns;
+    int frames, unsnapped, moved, uneven_a, uneven_b, uneven_s;
+    double shift_sum, shift_max;
+    int64_t period_ns, nominal_ns;
+    int relocks0, reslots0;
+    bool have_prev;
+    int64_t prev_err_a, prev_err_b, prev_err_s;
+    int prev_relocks;
+    // Offsets past the display link's refresh instant (ms in the log): of
+    // the planned times, of the stamps given to the layer, and of the
+    // enqueues; and the refreshes the frames went to (one frame each, two in
+    // one, or none in one: each a skip or a repeat).
+    struct avf_phase_stat planned, stamped, enqueued;
+    int occ_one, occ_two, occ_none;
+    int64_t prev_shown;
+    // Enqueue: lead before the stamp, and the pacing wait and readiness wait.
+    int enq;
+    double lead_min, lead_max, lead_sum, pace_sum, pace_max, ready_sum, ready_max;
+    // The layer's own counts at the window's start (-1: none read yet).
+    int64_t layer_total0, layer_dropped0;
+    // Frames sampled for cuts and stills, and what was found.
+    int sampled, cuts, stills, flats, unreadable;
+    bool frame_one_to_one;
+    double av_min, av_max;          // shown - planned, ns
+    int av_n;
+};
