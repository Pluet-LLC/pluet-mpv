+                   "stamp %.2f [%+.2f %+.2f], enqueue %.2f [%+.2f %+.2f], refreshes "
+                   "1:%d 2:%d 0:%d, uneven A=%d B=%d S=%d\n",
+                   pa / 1e6, pl / 1e6, ph / 1e6, sa / 1e6, sl / 1e6, sh / 1e6,
+                   ea / 1e6, el / 1e6, eh / 1e6, st->occ_one, st->occ_two, st->occ_none,
+                   st->uneven_a, st->uneven_b, st->uneven_s);
+        int ne = MPMAX(st->enq, 1);
+        MP_VERBOSE(vo, "vsync-snap pace %s %.2f: lead min %.1f avg %.1f max %.1f ms, "
