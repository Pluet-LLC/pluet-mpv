+// Pluet: the text recognised in a picture subtitle (sd_lavc.c), for the
+// primary and secondary subtitle tracks that have that picture.
+static void cmd_sub_picture_text(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    struct MPContext *mpctx = cmd->mpctx;
+    char *end = NULL;
+    struct sd_picture_text a = {
+        .pts = cmd->args[0].v.d,
+        .hash = strtoull(cmd->args[1].v.s, &end, 16),
+        .text = cmd->args[2].v.s,
+    };
+    if (!end || *end) {
+        cmd->success = false;
+        return;
+    }
+    for (int n = 0; n < num_ptracks[STREAM_SUB]; n++) {
+        struct track *track = mpctx->current_track[n][STREAM_SUB];
+        if (track && track->d_sub)
+            sub_control(track->d_sub, SD_CTRL_PICTURE_TEXT, &a);
+    }
+}
