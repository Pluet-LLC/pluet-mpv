+
+// The resource is cut into chunks. A worker thread per connection fetches
+// whole chunks with ranged requests (end_offset), into a small set of chunk
+// buffers the reader copies from; the reader waits only for the bytes it
+// asks for, which arrive as they are received, so the chunk it is in costs
+// no more latency than a single connection. Once the reader has read on
+// sequentially from one position, the chunks ahead of it are fetched too,
+// one per connection. A seek moves the window: fetches that left it are
+// stopped (their bytes are kept), and fetched chunks stay until their buffer
+// is needed, so the demuxer's reads of a header, an index at the end and the
+// start again cost nothing twice.
+//
+// A connection carries on from where its last reply ended: FFmpeg's http
+// protocol (patches 0080/0081) continues a bounded reply on the same
+// connection, or sends the next ranged request over it once a reply was read
+// to its end. A failed fetch is retried with backoff on a new connection; a
+// server that refuses more connections while others work makes the reader
+// use fewer from then on.
+
+#include <errno.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include <libavformat/avformat.h>
+#include <libavutil/error.h>
+#include <libavutil/opt.h>
+
+#include "http_parallel.h"
+
+#define MAX_CONNECTIONS 8
+#define MAX_ATTEMPTS 4
+
+struct chunk {
+    int64_t index;      // -1: free
+    uint8_t *data;
+    int64_t length;     // bytes the chunk has (the last one is short)
+    // Bytes [begin, filled) of the chunk have arrived. A reader that lands
+    // inside a chunk is served from there, not from the chunk's start.
+    int64_t begin;
+    int64_t filled;
+    int fetcher;        // worker fetching it, or -1
+    bool failed;
+    bool read;          // the reader took bytes from it
+    uint64_t used;      // LRU stamp
+};
+
+struct worker {
+    struct mp_http_parallel *p;
+    pthread_t thread;
+    int id;
+    AVIOContext *avio;
+    // Where the connection's reply stands, or -1 without one.
+    int64_t pos;
+    // The reader left this worker's chunk: stop the fetch. Read by the
+    // connection's interrupt callback.
+    volatile int abort;
+    // The chunk it fetches (-1: none), and whether its reply runs on to the
+    // end of the resource, so it flows into the next chunk with no request.
+    int64_t chunk;
+    bool open_ended;
+    bool adopted;
+};
+
+struct mp_http_parallel {
+    struct mp_http_parallel_params params;
+    char *url;
+    AVDictionary *options;
+    int64_t chunk_size;
+
+    pthread_mutex_t lock;
+    pthread_cond_t wakeup;
+
+    struct chunk *chunks;
+    int num_chunks;
+    struct worker workers[MAX_CONNECTIONS];
+    int num_workers;
+    // Workers allowed to fetch; lowered when the server turns connections down.
+    int active_limit;
+    bool threads_started[MAX_CONNECTIONS];
+
+    int64_t pos;
+    // Where the reader's current sequential run began.
+    int64_t run_start;
+    bool closing;
+    uint64_t clock;
+    struct mp_http_parallel_stats stats;
+};
+
+static void logf_(struct mp_http_parallel *p, int level, const char *fmt, ...)
+{
+    if (!p->params.log)
+        return;
+    char buf[256];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    p->params.log(p->params.log_ctx, level, buf);
+}
+
+// Stops the fetch of worker `w`, also on an adopted connection, whose
+// interrupt callback is its opener's. Lock held.
+static void stop_worker(struct worker *w)
+{
+    w->abort = 1;
+    if (w->adopted && w->p->params.adopt_abort)
+        *w->p->params.adopt_abort = 1;
+}
+
+static int worker_interrupt(void *ctx)
+{
+    struct worker *w = ctx;
+    struct mp_http_parallel *p = w->p;
+    if (w->abort || p->closing)
+        return 1;
+    return p->params.interrupt ? p->params.interrupt(p->params.interrupt_ctx) : 0;
+}
+
+static void timed_wait(struct mp_http_parallel *p, int64_t ms)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    ts.tv_sec += ms / 1000;
+    ts.tv_nsec += (ms % 1000) * 1000000;
+    if (ts.tv_nsec >= 1000000000) {
+        ts.tv_sec++;
+        ts.tv_nsec -= 1000000000;
+    }
+    pthread_cond_timedwait(&p->wakeup, &p->lock, &ts);
+}
+
+static int64_t num_chunks_total(struct mp_http_parallel *p)
+{
+    return (p->params.size + p->chunk_size - 1) / p->chunk_size;
+}
+
+static struct chunk *find_chunk(struct mp_http_parallel *p, int64_t index)
+{
+    for (int n = 0; n < p->num_chunks; n++) {
+        if (p->chunks[n].index == index)
+            return &p->chunks[n];
+    }
+    return NULL;
+}
+
+// The chunks the reader wants now: its own, and once it reads on
+// sequentially, one more per connection ahead of it.
+static void window(struct mp_http_parallel *p, int64_t *first, int64_t *last)
+{
+    int64_t total = num_chunks_total(p);
+    *first = p->pos / p->chunk_size;
+    *last = *first;
+    if (p->pos - p->run_start >= p->params.sequential_threshold)
+        *last = *first + p->active_limit;
+    if (*last > total - 1)
+        *last = total - 1;
+}
+
+static bool in_window(struct mp_http_parallel *p, int64_t index)
+{
+    int64_t first, last;
+    window(p, &first, &last);
+    return index >= first && index <= last;
+}
+
+static void release_slot(struct mp_http_parallel *p, struct chunk *c)
+{
+    if (c->index >= 0 && !c->read)
+        p->stats.wasted += c->filled - c->begin;
+    c->index = -1;
+    c->begin = c->filled = 0;
+    c->failed = false;
+    c->read = false;
+}
+
+// A buffer for chunk `index`: its own, a free one, or the least recently
+// used one outside the window that nobody fetches.
+static struct chunk *slot_for(struct mp_http_parallel *p, int64_t index)
+{
+    struct chunk *c = find_chunk(p, index);
+    if (c)
+        return c;
+    struct chunk *victim = NULL;
+    for (int n = 0; n < p->num_chunks; n++) {
+        struct chunk *s = &p->chunks[n];
+        if (s->index < 0) {
+            victim = s;
+            break;
+        }
+        if (s->fetcher >= 0 || in_window(p, s->index))
+            continue;
+        if (!victim || s->used < victim->used)
+            victim = s;
+    }
+    if (!victim)
+        return NULL;
+    release_slot(p, victim);
+    victim->index = index;
+    victim->length = p->params.size - index * p->chunk_size;
+    if (victim->length > p->chunk_size)
+        victim->length = p->chunk_size;
+    victim->used = ++p->clock;
+    return victim;
+}
+
+// The chunk this worker fetches next, or NULL. Prefers the one its
+// connection already stands at, then the nearest to the reader.
+static struct chunk *pick(struct worker *w)
+{
+    struct mp_http_parallel *p = w->p;
+    if (w->id >= p->active_limit || p->pos >= p->params.size)
+        return NULL;
+    int64_t first, last;
+    window(p, &first, &last);
+    int64_t best = -1;
+    // The reader's own chunk starts where the reader is, unless what it has
+    // reaches there.
+    int64_t at = p->pos - first * p->chunk_size;
+    struct chunk *own = find_chunk(p, first);
+    if (own && own->fetcher < 0 && !own->failed && (at < own->begin || at > own->filled)) {
+        if (!own->read)
+            p->stats.wasted += own->filled - own->begin;
+        own->begin = own->filled = at;
+        own->read = false;
+    }
+    for (int64_t i = first; i <= last; i++) {
+        struct chunk *c = find_chunk(p, i);
+        if (c && (c->fetcher >= 0 || c->failed || c->filled == c->length))
+            continue;
+        // A chunk another idle connection stands at is that one's to fetch
+        // (an open-ended reply runs on into it with no request).
+        int64_t start = i * p->chunk_size + (c ? c->filled : 0);
+        bool others = false;
+        for (int n = 0; n < p->num_workers; n++) {
+            struct worker *o = &p->workers[n];
+            if (o != w && n < p->active_limit && o->avio && o->chunk < 0 && o->pos == start)
+                others = true;
+        }
+        if (others && w->pos != start)
+            continue;
+        if (w->pos == start) {
+            best = i;
+            break;
+        }
+        if (best < 0)
+            best = i;
+    }
+    if (best < 0)
+        return NULL;
+    bool fresh = !find_chunk(p, best);
+    struct chunk *c = slot_for(p, best);
+    if (c) {
+        if (fresh && best == first)
+            c->begin = c->filled = at;
+        c->fetcher = w->id;
+    }
+    return c;
+}
+
+static void close_connection(struct worker *w)
+{
+    if (w->avio)
+        avio_closep(&w->avio);
+    w->pos = -1;
+    w->adopted = false;
+    w->open_ended = false;
+}
+
+// A connection whose next bytes are `start`, asking for no more than `end`
+// (0: to the end of the resource).
+static int connect_at(struct worker *w, int64_t start, int64_t end)
+{
+    struct mp_http_parallel *p = w->p;
+    if (w->avio) {
+        // Grow or bound the request this reply continues with, then move.
+        // An open-ended reply stays open-ended while it is read on.
+        if (!(w->open_ended && end == 0 && w->pos == start))
+            av_opt_set_int(w->avio, "end_offset", end, AV_OPT_SEARCH_CHILDREN);
+        if (w->pos == start)
+            return 0;
+        pthread_mutex_lock(&p->lock);
+        p->stats.requests++;
+        pthread_mutex_unlock(&p->lock);
+        if (avio_seek(w->avio, start, SEEK_SET) == start) {
+            w->pos = start;
+            return 0;
+        }
+        close_connection(w);
+    }
+    AVDictionary *options = NULL;
+    av_dict_copy(&options, p->options, 0);
+    char buf[32];
+    snprintf(buf, sizeof(buf), "%lld", (long long)start);
+    av_dict_set(&options, "offset", buf, 0);
+    if (end) {
+        snprintf(buf, sizeof(buf), "%lld", (long long)end);
+        av_dict_set(&options, "end_offset", buf, 0);
+    }
+    AVIOInterruptCB cb = {.callback = worker_interrupt, .opaque = w};
+    pthread_mutex_lock(&p->lock);
+    p->stats.requests++;
+    p->stats.opens++;
+    pthread_mutex_unlock(&p->lock);
+    int err = avio_open2(&w->avio, p->url, AVIO_FLAG_READ, &cb, &options);
+    av_dict_free(&options);
+    if (err < 0) {
+        w->avio = NULL;
+        return err;
+    }
+    w->pos = start;
+    return 0;
+}
+
+// Fetches the rest of `c`. Called and returns with the lock held.
+static void fetch(struct worker *w, struct chunk *c)
+{
+    struct mp_http_parallel *p = w->p;
+    int attempts = 0;
+    w->abort = 0;
+    w->chunk = c->index;
+    while (c->filled < c->length && !p->closing && !w->abort) {
+        int64_t base = c->index * p->chunk_size;
+        int64_t start = base + c->filled, end = base + c->length;
+        // Until the reader reads on, it is served as by one connection: the
+        // reply for its chunk runs on into the next ones, with no request at
+        // a chunk's end. Chunks fetched ahead are asked for one by one.
+        bool open_ended = c->index == p->pos / p->chunk_size &&
+                          p->pos - p->run_start < p->params.sequential_threshold;
+        pthread_mutex_unlock(&p->lock);
+        int err = connect_at(w, start, open_ended ? 0 : end);
+        pthread_mutex_lock(&p->lock);
+        w->open_ended = err >= 0 && open_ended;
+        pthread_mutex_unlock(&p->lock);
+        int64_t got = 0;
+        while (err >= 0 && got < end - start) {
+            int want = end - start - got > 262144 ? 262144 : (int)(end - start - got);
+            int r = avio_read_partial(w->avio, c->data + (start - base) + got, want);
+            if (r <= 0) {
+                err = r ? r : AVERROR_EOF;
+                break;
+            }
+            got += r;
+            pthread_mutex_lock(&p->lock);
+            w->pos += r;
+            c->filled += r;
+            p->stats.bytes += r;
+            bool stop = w->abort || p->closing;
+            pthread_cond_broadcast(&p->wakeup);
+            pthread_mutex_unlock(&p->lock);
+            if (stop)
+                break;
+        }
+        pthread_mutex_lock(&p->lock);
+        if (c->filled == c->length || w->abort || p->closing) {
+            if (w->abort || p->closing) {
+                // An interrupted reply is unusable.
+                pthread_mutex_unlock(&p->lock);
+                close_connection(w);
+                pthread_mutex_lock(&p->lock);
+            }
+            break;
+        }
+        // The connection failed: retry on a new one, with backoff. A server
+        // that turns this connection down while others work has a limit.
+        pthread_mutex_unlock(&p->lock);
+        close_connection(w);
+        pthread_mutex_lock(&p->lock);
+        int working = 0;
+        for (int n = 0; n < p->num_workers; n++)
+            working += n != w->id && p->workers[n].avio != NULL;
+        if (got == 0 && working > 0) {
+            // Refused while other connections work: the server has a limit.
+            // Use as many as work now; this chunk goes to one of them.
+            if (working < p->active_limit)
+                p->active_limit = working;
+            logf_(p, AV_LOG_WARNING, "server refused another connection (%s); using %d from now on\n",
+                  av_err2str(err), p->active_limit);
+            break;
+        }
+        // Playback is being stopped: nothing failed.
+        if (p->params.interrupt && p->params.interrupt(p->params.interrupt_ctx))
+            break;
+        if (++attempts >= MAX_ATTEMPTS) {
+            logf_(p, AV_LOG_ERROR, "chunk at %lld failed: %s\n", (long long)start, av_err2str(err));
+            c->failed = true;
+            break;
+        }
+        p->stats.retries++;
+        logf_(p, AV_LOG_WARNING, "connection %d failed at %lld (%s), retrying\n", w->id + 1,
+              (long long)(start + got), av_err2str(err));
+        timed_wait(p, 250LL << (attempts - 1));
+    }
+    c->fetcher = -1;
+    w->chunk = -1;
+    w->abort = 0;
+    pthread_cond_broadcast(&p->wakeup);
+}
+
+static void *worker_thread(void *arg)
+{
+    struct worker *w = arg;
+    struct mp_http_parallel *p = w->p;
+    pthread_mutex_lock(&p->lock);
+    while (!p->closing) {
+        struct chunk *c = pick(w);
+        if (c) {
+            fetch(w, c);
+            continue;
+        }
+        // A connection beyond the server's limit is given back.
+        if (w->id >= p->active_limit && w->avio) {
+            pthread_mutex_unlock(&p->lock);
+            close_connection(w);
+            pthread_mutex_lock(&p->lock);
+        }
+        timed_wait(p, 100);
+    }
+    pthread_mutex_unlock(&p->lock);
+    close_connection(w);
+    return NULL;
+}
+
+struct mp_http_parallel *mp_http_parallel_create(const struct mp_http_parallel_params *params)
+{
+    struct mp_http_parallel *p = calloc(1, sizeof(*p));
+    if (!p || params->size <= 0 || params->connections < 2 || params->chunk_size < 65536)
+        goto fail;
+    p->params = *params;
+    p->url = strdup(params->url);
+    if (!p->url)
+        goto fail;
+    av_dict_copy(&p->options, params->options, 0);
+    p->chunk_size = params->chunk_size;
+    p->num_workers = params->connections > MAX_CONNECTIONS ? MAX_CONNECTIONS : params->connections;
+    p->active_limit = p->num_workers;
+    // The reader's chunk, one ahead per connection, and two behind it.
+    p->num_chunks = p->num_workers + 3;
+    p->chunks = calloc(p->num_chunks, sizeof(p->chunks[0]));
+    if (!p->chunks)
+        goto fail;
+    for (int n = 0; n < p->num_chunks; n++) {
+        p->chunks[n].index = -1;
+        p->chunks[n].fetcher = -1;
+        p->chunks[n].data = malloc(p->chunk_size);
+        if (!p->chunks[n].data)
+            goto fail;
+    }
+    pthread_mutex_init(&p->lock, NULL);
+    pthread_cond_init(&p->wakeup, NULL);
+    for (int n = 0; n < p->num_workers; n++) {
+        struct worker *w = &p->workers[n];
+        w->p = p;
+        w->id = n;
+        w->pos = -1;
+        w->chunk = -1;
+    }
+    // The open connection serves the start of the resource, as it would
+    // without this reader.
+    if (params->adopt) {
+        p->workers[0].avio = params->adopt;
+        p->workers[0].pos = 0;
+        p->workers[0].adopted = true;
+        p->workers[0].open_ended = true;
+    }
+    for (int n = 0; n < p->num_workers; n++) {
+        if (pthread_create(&p->workers[n].thread, NULL, worker_thread, &p->workers[n])) {
+            mp_http_parallel_destroy(p);
+            return NULL;
+        }
+        p->threads_started[n] = true;
+    }
+    logf_(p, AV_LOG_VERBOSE, "%d connections, %lld KiB chunks, %lld bytes\n", p->num_workers,
+          (long long)(p->chunk_size / 1024), (long long)params->size);
+    return p;
+
+fail:
+    if (params->adopt) {
+        AVIOContext *adopt = params->adopt;
+        avio_closep(&adopt);
+    }
+    if (p) {
+        if (p->chunks) {
+            for (int n = 0; n < p->num_chunks; n++)
+                free(p->chunks[n].data);
+        }
+        free(p->chunks);
+        av_dict_free(&p->options);
+        free(p->url);
+        free(p);
+    }
+    return NULL;
+}
+
+int mp_http_parallel_read(struct mp_http_parallel *p, void *buffer, int size)
+{
+    pthread_mutex_lock(&p->lock);
+    int r;
+    while (1) {
+        if (p->closing) {
+            r = AVERROR_EXIT;
+            break;
+        }
+        if (p->pos >= p->params.size) {
+            r = 0;
+            break;
+        }
+        int64_t index = p->pos / p->chunk_size;
+        struct chunk *c = find_chunk(p, index);
+        int64_t offset = p->pos - index * p->chunk_size;
+        if (c && c->begin <= offset && c->filled > offset) {
+            int64_t n = c->filled - offset;
+            if (n > size)
+                n = size;
+            memcpy(buffer, c->data + offset, n);
+            p->pos += n;
+            c->read = true;
+            c->used = ++p->clock;
+            r = (int)n;
+            // Reading on may open the window further.
+            pthread_cond_broadcast(&p->wakeup);
+            break;
+        }
+        if (c && c->failed && c->fetcher < 0) {
+            r = AVERROR(EIO);
+            break;
+        }
+        pthread_cond_broadcast(&p->wakeup);
+        if (p->params.interrupt && p->params.interrupt(p->params.interrupt_ctx)) {
+            r = AVERROR_EXIT;
+            break;
+        }
+        timed_wait(p, 20);
+    }
+    pthread_mutex_unlock(&p->lock);
+    return r;
+}
+
+void mp_http_parallel_seek(struct mp_http_parallel *p, int64_t pos)
+{
+    pthread_mutex_lock(&p->lock);
+    if (pos != p->pos) {
+        p->pos = pos;
+        p->run_start = pos;
+        for (int n = 0; n < p->num_chunks; n++) {
+            struct chunk *c = &p->chunks[n];
+            // A failed chunk gets another try once asked for again.
+            if (c->failed && c->fetcher < 0)
+                c->failed = false;
+            if (c->index < 0 || c->fetcher < 0)
+                continue;
+            // A fetch the reader left, or one that would make it wait for
+            // more than a short read to reach it, stops; the reader's own
+            // chunk then starts again where the reader is.
+            int64_t at = pos - c->index * p->chunk_size;
+            bool own = at >= 0 && at < c->length;
+            if (!in_window(p, c->index) || (own && (at < c->begin || at > c->filled + 262144)))
+                stop_worker(&p->workers[c->fetcher]);
+        }
+        pthread_cond_broadcast(&p->wakeup);
+    }
+    pthread_mutex_unlock(&p->lock);
+}
+
+void mp_http_parallel_get_stats(struct mp_http_parallel *p, struct mp_http_parallel_stats *stats)
+{
+    pthread_mutex_lock(&p->lock);
+    *stats = p->stats;
+    for (int n = 0; n < p->num_chunks; n++) {
+        if (p->chunks[n].index >= 0 && !p->chunks[n].read)
+            stats->wasted += p->chunks[n].filled - p->chunks[n].begin;
+    }
+    pthread_mutex_unlock(&p->lock);
+}
+
+void mp_http_parallel_destroy(struct mp_http_parallel *p)
+{
+    if (!p)
+        return;
+    pthread_mutex_lock(&p->lock);
+    p->closing = true;
+    for (int n = 0; n < p->num_workers; n++)
+        stop_worker(&p->workers[n]);
+    pthread_cond_broadcast(&p->wakeup);
+    pthread_mutex_unlock(&p->lock);
+    for (int n = 0; n < p->num_workers; n++) {
+        if (p->threads_started[n])
+            pthread_join(p->workers[n].thread, NULL);
+        else
+            close_connection(&p->workers[n]);
+    }
+    for (int n = 0; n < p->num_chunks; n++)
+        free(p->chunks[n].data);
+    free(p->chunks);
+    pthread_cond_destroy(&p->wakeup);
+    pthread_mutex_destroy(&p->lock);
+    av_dict_free(&p->options);
+    free(p->url);
+    free(p);
+}
