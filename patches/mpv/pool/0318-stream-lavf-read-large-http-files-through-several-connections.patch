+
+// Reads one HTTP(S) resource through several connections: the chunk the
+// reader is in, and once it reads on sequentially, the chunks ahead of it,
+// each with a ranged request. Depends on libavformat and pthreads only.
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <libavformat/avio.h>
+#include <libavutil/dict.h>
+
+struct mp_http_parallel;
+
+struct mp_http_parallel_params {
+    const char *url;
+    // Options for every connection's avio_open2() (copied).
+    const AVDictionary *options;
+    // The resource's size, which must be known.
+    int64_t size;
+    // Connections at most (2..8), bytes per ranged request.
+    int connections;
+    int64_t chunk_size;
+    // Bytes read on from one position before chunks ahead are fetched.
+    int64_t sequential_threshold;
+    // An open connection positioned at 0 that the first worker takes over
+    // (its reply may be open-ended), or NULL. Owned by the reader after
+    // mp_http_parallel_create(), also when that fails. Its interrupt callback
+    // must also return non-zero while *adopt_abort is set, which the reader
+    // does to stop its reply.
+    AVIOContext *adopt;
+    volatile int *adopt_abort;
+    // Called by every connection's I/O and by waiting readers; non-zero
+    // aborts. Any thread.
+    int (*interrupt)(void *ctx);
+    void *interrupt_ctx;
+    // level: AV_LOG_*. Any thread.
+    void (*log)(void *ctx, int level, const char *msg);
+    void *log_ctx;
+};
+
+struct mp_http_parallel_stats {
+    int64_t requests;       // ranged requests made (opens and seeks)
+    int64_t opens;          // connections opened
+    int64_t bytes;          // bytes received
+    int64_t wasted;         // bytes received for chunks dropped unread
+    int64_t retries;
+};
+
+struct mp_http_parallel *mp_http_parallel_create(const struct mp_http_parallel_params *params);
+// As AVIOContext reads: bytes read, 0 at the end, negative on an error or an
+// interrupt.
+int mp_http_parallel_read(struct mp_http_parallel *p, void *buffer, int size);
+// Only moves the read position; never blocks on the network.
+void mp_http_parallel_seek(struct mp_http_parallel *p, int64_t pos);
+void mp_http_parallel_get_stats(struct mp_http_parallel *p, struct mp_http_parallel_stats *stats);
+void mp_http_parallel_destroy(struct mp_http_parallel *p);
