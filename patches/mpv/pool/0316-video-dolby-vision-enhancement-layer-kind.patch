 // Create a new mp_image reference to av_frame.
+// --- dovi el kind (host-testable: libavutil types only) ---
+// What a Dolby Vision RPU says of its enhancement layer, decided as libdovi's
+// RpuDataNlq::is_mel() (dovi_tool's "Profile: 7 (MEL)" / "(FEL)"): an RPU
+// with no residual (disable_residual_flag, a non-zero rpu_format layout, or
+// no NLQ method) has none; one whose NLQ is the identity in all three
+// components (offset 0, vdr_in_max 1.0, a zero linear dead zone) is a
+// minimal enhancement layer, which a decoder may drop without changing the
+// picture; anything else is a full enhancement layer. vdr_in_max and the
+// dead zone are fixed point with coef_log2_denom fractional bits, as FFmpeg
+// stores them (a float RPU is scaled the same way).
+static int mp_dovi_el_kind(int disable_residual, int rpu_format,
+                           int nlq_method, int coef_log2_denom,
+                           const uint16_t offset[3], const uint64_t in_max[3],
+                           const uint64_t dz_slope[3],
+                           const uint64_t dz_threshold[3])
+{
+    // nlq_method: 0 linear dead zone, anything else (FFmpeg's NONE, -1, or a
+    // reserved value) carries no residual mapping.
+    if (disable_residual || (rpu_format & 0x700) || nlq_method != 0 ||
+        coef_log2_denom < 0 || coef_log2_denom > 63)
+        return 0;
+    const uint64_t one = (uint64_t)1 << coef_log2_denom;
+    for (int c = 0; c < 3; c++) {
+        if (offset[c] || in_max[c] != one || dz_slope[c] || dz_threshold[c])
+            return 2;
+    }
+    return 1;
+}
+
+// mp_dovi_el_kind() of an FFmpeg-parsed RPU: an enum mp_dovi_el value.
+static int mp_dovi_el_from_av(const AVDOVIMetadata *metadata)
+{
+    const AVDOVIRpuDataHeader *hdr = av_dovi_get_header(metadata);
+    const AVDOVIDataMapping *map = av_dovi_get_mapping(metadata);
+    uint16_t offset[3];
+    uint64_t in_max[3], slope[3], threshold[3];
+    for (int c = 0; c < 3; c++) {
+        offset[c] = map->nlq[c].nlq_offset;
+        in_max[c] = map->nlq[c].vdr_in_max;
+        slope[c] = map->nlq[c].linear_deadzone_slope;
+        threshold[c] = map->nlq[c].linear_deadzone_threshold;
+    }
+    int method = map->nlq_method_idc == AV_DOVI_NLQ_LINEAR_DZ ? 0 : -1;
+    // 0, 1 and 2 are MP_DOVI_EL_NONE, _MEL and _FEL.
+    return mp_dovi_el_kind(hdr->disable_residual_flag, hdr->rpu_format, method,
+                           hdr->coef_log2_denom, offset, in_max, slope,
+                           threshold);
+}
+// --- end dovi el kind ---
+
 struct mp_image *mp_image_from_av_frame(struct AVFrame *src)
 {
     struct mp_image *dst = &(struct mp_image){0};
@@ -1210,6 +1261,7 @@ struct mp_image *mp_image_from_av_frame(struct AVFrame *src)
     if (sd) {
 #ifdef PL_HAVE_LAV_DOLBY_VISION
         const AVDOVIMetadata *metadata = (const AVDOVIMetadata *)sd->buf->data;
+        dst->params.dovi_el = mp_dovi_el_from_av(metadata);
         dst->dovi = dovi = av_buffer_alloc(sizeof(struct pl_dovi_metadata));
         MP_HANDLE_OOM(dovi);
         pl_map_avdovi_metadata(&dst->params.color, &dst->params.repr,
diff --git a/video/mp_image.h b/video/mp_image.h
index f5c1562..82f4674 100644
--- a/video/mp_image.h
+++ b/video/mp_image.h
@@ -66,6 +66,16 @@ struct mp_image_params {
     // Flags for f_enhancement_pair.c to not inherit flags from EL.
     bool no_dovi;
     bool no_enhancement_layer;
+    // Dolby Vision enhancement layer the frame's RPU describes (enum
+    // mp_dovi_el), read from FFmpeg's AVDOVIMetadata. Dynamic metadata: not
+    // compared by mp_image_params_equal(), so it never reconfigures the chain.
+    int dovi_el;
+};
+
+enum mp_dovi_el {
+    MP_DOVI_EL_NONE = 0, // no RPU, or one without a residual (profiles 5, 8, 10)
+    MP_DOVI_EL_MEL,      // minimal enhancement layer: its residual is a no-op
+    MP_DOVI_EL_FEL,      // full enhancement layer: the picture needs it
 };
 
