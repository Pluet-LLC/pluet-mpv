# Apple (macOS/iOS/tvOS/Catalyst/visionOS) patch series for mpv, applied after
# series.common. One pool filename per line; order is authoritative and
# nothing is sorted.
0001-player-add-moltenvk-context.patch
0002-revert-build-static.patch
0003-fix-coreaudio-hal-guards-for-non-macos.patch
0004-avfoundation-video-output.patch
0005-audiounit-reject-spdif.patch
0006-avfoundation-avplayer-compressed-passthrough.patch
0015-avfoundation-bound-pcm-lookahead.patch
0019-avfoundation-configurable-compressed-audio.patch
0020-avfoundation-compressed-clock-accounting.patch
0021-avfoundation-configurable-compressed-lead.patch
0022-avfoundation-slow-source-preroll-patience.patch
0023-avfoundation-refuse-reads-past-the-write-head.patch
# Every group but android: a MediaCodec that starts failing mid-stream rarely
# recovers, and waiting out its error burst only delays the software fallback.
0025-vd-lavc-recover-hwdec-after-decode-error-burst.patch
# Dropped on mpv 0.42: 0028-ao-coreaudio-uninit-on-init-failure.patch, upstream in mpv 0.42 (c5d391ad, ao_coreaudio cleanup on init failure)
0037-ao-coreaudio-typed-channel-map.patch
0033-avfoundation-compressed-software-volume.patch
0036-avfoundation-restart-only-a-running-pcm-sink.patch
0039-ao-spatial-render-truehd-atmos-and-dts-x.patch
0040-ao-decode-the-playing-track-to-pcm-when-passthrough-fails.patch
0041-avfoundation-say-when-avplayer-never-asked-for-the-stream.patch
0042-avfoundation-anchor-the-passthrough-clock-to-the-playhead.patch
# OSD canvas: a cheaper exact libass blend (test_avf_osd_blend.sh). Its
# per-buffer dirty rects are replaced by 0048.
0043-avfoundation-clear-and-blend-the-osd-canvas-for-less.patch
# vo_avfoundation takes a frame early on a wakeup the player makes anyway,
# instead of on VO timers of its own (--avfoundation-queue-slack-ms, off).
0044-vo-queue-slack-for-vos-that-present-by-timestamp.patch
# --hwdec-threads defaults to 1: VideoToolbox decodes one frame at a time.
0045-vd-lavc-one-hwdec-thread-by-default-on-apple-platforms.patch
# Pluet (corruptmods) patches, 03xx, on top of everything above.
# vo_avfoundation never waits on the main thread at teardown, and at most
# 500 ms anywhere else (test test_avf_main_thread_link.sh).
0300-avfoundation-never-wait-on-the-main-thread-at-teardown.patch
# --vd-lavc-dv-conversion sets FFmpeg 0300's dv_conversion_mode.
0301-vd-lavc-dolby-vision-conversion-option.patch
# The passthrough sink's mid-stream stall watchdog, and its audio session
# interruption and route-change handling (tests test_ao_avfoundation_stall.sh,
# test_ao_avfoundation_fallback.sh).
0302-avfoundation-supervise-the-passthrough-sink-mid-stream.patch
# A codec whose passthrough failed mid-stream is decoded to PCM on this
# player until the audio route changes (--audio-spdif-backoff; test
# test_audio_passthrough_fallback.sh).
0303-player-back-off-passthrough-for-a-codec-that-failed-on-this-route.patch
# 0025's recovery as --hwdec-recover-keyframes/--hwdec-recover-max-frames,
# defaults unchanged (test test_hwdec_recovery.sh).
0306-vd-lavc-options-for-the-hwdec-error-recovery.patch
# Host-mode frames stamped a quarter refresh before the refresh they are
# shown on, chosen with hysteresis, and enqueued at a fixed point of the
# refresh, so the audio clock's drift never puts the enqueues where an Apple
# TV drops frames (--avfoundation-vsync-snap, -snap-pace; test
# test_avf_vsync_snap.sh).
0307-avfoundation-stamp-frames-inside-their-refresh.patch
# Upstream (edde746/mpv-build) Apple patches taken after Pluet's 03xx, so
# 0300's bounded main-thread waits and 0307's stamps, lead and pacing stay as
# they are: 0046 and 0048 apply as upstream wrote them; 0047 is covered by
# 0300 and 0049 (opt-in) is not taken; 0050-0053 are ported onto 0300/0307 as
# 0308-0311.
# Startup: a file's first frame is on screen before the audio output opens.
0046-player-first-video-frame-before-the-audio-output-opens.patch
# OSD canvas: a frame clears and blends only the 32 px tiles of its buffer
# that it changes, and copies from the previous canvas what that one already
# holds (common 0234's pixel ids; test_avf_osd_damage.sh).
0048-avfoundation-redraw-only-the-canvas-tiles-a-frame-changes.patch
# Upstream 0050-0053 ported onto 0300 and 0307: media-time stamps never go
# back across a reset (test_avf_media_stamp.sh), the OSD layer primed before
# its first subtitle, subtitles in their video's colour (test_avf_osd_color.sh)
# and untagged VideoToolbox frames decoded as mpv does.
0308-avfoundation-port-0050-stamp-media-frames-after-every-frame-before.patch
0309-avfoundation-port-0051-prime-the-osd-layer-before-its-first-subtitle.patch
0310-avfoundation-port-0052-show-subtitles-in-the-colour-of-their-video.patch
0311-avfoundation-port-0053-decode-untagged-videotoolbox-frames-as-mpv-does.patch
# Measurement only: whether subtitles and their frames share a refresh,
# logged at the verbose level (test_avf_subref.sh).
0312-avfoundation-log-whether-subtitles-and-frames-share-a-refresh.patch
# Upstream 0056 (restart frames: subtitles and lead after a start, seek or
# resume) behind --avfoundation-restart-frames, default off; every auto
# pacing decision logged.
0313-avfoundation-restart-frames-switch-and-pace-decision-log.patch
# Dolby Vision profile 7: whether the RPU's enhancement layer is minimal or
# full (video-params/dolby-vision-el), for the player's question about a FEL
# title (test test_dovi_rpu_layers.sh).
0316-video-dolby-vision-enhancement-layer-kind.patch
# TrueHD Atmos and DTS:X rendered to 7.1.4 go out as lossless linear PCM over
# HDMI (--ao-spatial-output, APAC elsewhere and as the fallback), and Force
# Dolby MAT sends decoded multichannel PCM the same way
# (--ao-spatial-force-mat); spatial-audio-output says which. With
# SpatialAudioBridge 0001 (tests test_ao_spatial.sh, test_spatial_lossless.sh).
0317-ao-spatial-lossless-linear-pcm-and-force-dolby-mat.patch
# Large http(s) files read through several connections, chunks ahead of a
# reader that reads on (--stream-http-connections=4,
# --stream-http-chunk-size=2MiB; test test_http_parallel.sh).
0318-stream-lavf-read-large-http-files-through-several-connections.patch
# Decoded PCM at its own rate where the route takes it (96/192 kHz), and the
# route's rate and channels in the log.
0319-ao-audiounit-ask-the-route-for-the-stream-sample-rate.patch
# Blu-ray (PGS) and DVD subtitles drawn as text the app reads from the
# pictures (--sub-picture-text-callback, the sub-picture-text command), in
# the text subtitle style; pictures stay pictures without it (Pluet's
# PictureSubtitleText, checked by its tool/subtitle_ocr/engine_check.sh).
0320-sd-lavc-picture-subtitles-shown-as-text.patch
