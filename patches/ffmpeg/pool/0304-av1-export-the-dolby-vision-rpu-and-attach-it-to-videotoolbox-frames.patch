diff --git a/libavcodec/videotoolbox.c b/libavcodec/videotoolbox.c
index ae43a98..d586cff 100644
--- a/libavcodec/videotoolbox.c
+++ b/libavcodec/videotoolbox.c
@@ -161,6 +161,27 @@ static int videotoolbox_postproc_frame(void *avctx, AVFrame *frame)
     return 0;
 }
 
+void ff_videotoolbox_attach_dovi_rpu(AVFrame *frame)
+{
+    CVPixelBufferRef pixbuf;
+    const AVFrameSideData *sd;
+    CFDataRef data;
+
+    if (frame->format != AV_PIX_FMT_VIDEOTOOLBOX)
+        return;
+    pixbuf = (CVPixelBufferRef)frame->data[3];
+    sd = av_frame_get_side_data(frame, AV_FRAME_DATA_DOVI_RPU_BUFFER);
+    if (!pixbuf || !sd || !sd->size ||
+        CVBufferGetAttachment(pixbuf, CFSTR("DolbyVisionRPUData"), NULL))
+        return;
+    data = CFDataCreate(kCFAllocatorDefault, sd->data, sd->size);
+    if (!data)
+        return;
+    CVBufferSetAttachment(pixbuf, CFSTR("DolbyVisionRPUData"), data,
+                          kCVAttachmentMode_ShouldPropagate);
+    CFRelease(data);
+}
+
 int ff_videotoolbox_alloc_frame(AVCodecContext *avctx, AVFrame *frame)
 {
     size_t      size = sizeof(VTHWFrame);
