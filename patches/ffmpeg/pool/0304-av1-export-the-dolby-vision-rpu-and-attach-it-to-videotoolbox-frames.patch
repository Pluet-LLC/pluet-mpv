diff --git a/libavcodec/dovi_rpu.h b/libavcodec/dovi_rpu.h
index 1b74983..6fec8e8 100644
--- a/libavcodec/dovi_rpu.h
+++ b/libavcodec/dovi_rpu.h
@@ -174,6 +174,24 @@ enum {
 int ff_dovi_rpu_generate(DOVIContext *s, const AVDOVIMetadata *metadata,
                          int flags, uint8_t **out_rpu, int *out_size);
 
+/**
+ * Attach the RPU that [frame]'s AV_FRAME_DATA_DOVI_METADATA describes as
+ * AV_FRAME_DATA_DOVI_RPU_BUFFER, in the layout the HEVC decoder exports it
+ * (the UNSPEC62 NAL payload after its two-byte header: the 0x19 prefix, the
+ * RPU, emulation prevention included), for a decoder whose bitstream wraps
+ * the RPU otherwise (AV1: ITU-T T.35 and EMDF). Display pipelines that take
+ * an RPU per frame (Apple's DolbyVisionRPUData) take it in that layout.
+ *
+ * `enc` is a context of the caller's own, used only for this: its state
+ * follows the RPUs generated with it. Its configuration is `dec`'s, without
+ * metadata compression. A frame without metadata, or that already has an
+ * RPU buffer, is left alone.
+ *
+ * Returns 0 or a negative error code; the frame is unchanged on error.
+ */
+int ff_dovi_attach_rpu_buffer(DOVIContext *enc, const DOVIContext *dec,
+                              AVFrame *frame);
+
 
 /***************************************************
  * The following section is for internal use only. *
diff --git a/libavcodec/dovi_rpuenc.c b/libavcodec/dovi_rpuenc.c
index fa351c2..18da565 100644
--- a/libavcodec/dovi_rpuenc.c
+++ b/libavcodec/dovi_rpuenc.c
@@ -20,9 +20,13 @@
  * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
  */
 
+#include <stddef.h>
+#include <string.h>
+
 #include "libavutil/attributes.h"
 #include "libavutil/avassert.h"
 #include "libavutil/crc.h"
+#include "libavutil/log.h"
 #include "libavutil/mem.h"
 #include "libavutil/refstruct.h"
 
@@ -940,3 +944,84 @@ int ff_dovi_rpu_generate(DOVIContext *s, const AVDOVIMetadata *metadata,
         return 0;
     }
 }
+
+// The verifying parse below reports what it refuses at trace level: an RPU
+// this writer cannot represent is a property of the stream, met on every
+// frame, and the caller already says so once.
+typedef struct QuietLog {
+    const AVClass *class;
+    int level_offset;
+} QuietLog;
+
+static const AVClass quiet_log_class = {
+    .class_name                = "dovi_rpu_check",
+    .item_name                 = av_default_item_name,
+    .version                   = LIBAVUTIL_VERSION_INT,
+    .log_level_offset_offset   = offsetof(QuietLog, level_offset),
+};
+
+// Whether FFmpeg's own parser takes the RPU written in the NAL layout (0x19
+// prefix, emulation prevention): a consumer must never be handed one that
+// does not describe the frame.
+static int rpu_parses(const uint8_t *nal, int size)
+{
+    QuietLog quiet = { &quiet_log_class, AV_LOG_TRACE - AV_LOG_PANIC };
+    DOVIContext check = { .logctx = &quiet };
+    uint8_t *raw = av_malloc(size + AV_INPUT_BUFFER_PADDING_SIZE);
+    int n = 0, ret;
+
+    if (!raw)
+        return AVERROR(ENOMEM);
+    for (int i = 0; i < size; i++) {
+        if (i >= 2 && nal[i] == 3 && !nal[i - 1] && !nal[i - 2])
+            continue;
+        raw[n++] = nal[i];
+    }
+    memset(raw + n, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+    ret = ff_dovi_rpu_parse(&check, raw, n, AV_EF_CRCCHECK);
+    ff_dovi_ctx_unref(&check);
+    av_free(raw);
+    return ret;
+}
+
+int ff_dovi_attach_rpu_buffer(DOVIContext *enc, const DOVIContext *dec,
+                              AVFrame *frame)
+{
+    const AVFrameSideData *sd = av_frame_get_side_data(frame, AV_FRAME_DATA_DOVI_METADATA);
+    AVBufferRef *buf;
+    uint8_t *rpu = NULL;
+    int size = 0, ret;
+
+    if (!sd || av_frame_get_side_data(frame, AV_FRAME_DATA_DOVI_RPU_BUFFER))
+        return 0;
+
+    enc->logctx = dec->logctx;
+    enc->cfg = dec->cfg;
+    enc->cfg.dv_md_compression = AV_DOVI_COMPRESSION_NONE;
+    if (!enc->cfg.dv_profile)
+        return 0;
+
+    ret = ff_dovi_rpu_generate(enc, (const AVDOVIMetadata *)sd->data,
+                               FF_DOVI_WRAP_NAL, &rpu, &size);
+    if (ret < 0)
+        return ret;
+    if (!rpu || size <= 0) {
+        av_free(rpu);
+        return 0;
+    }
+    if ((ret = rpu_parses(rpu, size)) < 0) {
+        av_free(rpu);
+        return ret == AVERROR(ENOMEM) ? ret : AVERROR_INVALIDDATA;
+    }
+
+    buf = av_buffer_create(rpu, size, NULL, NULL, 0);
+    if (!buf) {
+        av_free(rpu);
+        return AVERROR(ENOMEM);
+    }
+    if (!av_frame_new_side_data_from_buf(frame, AV_FRAME_DATA_DOVI_RPU_BUFFER, buf)) {
+        av_buffer_unref(&buf);
+        return AVERROR(ENOMEM);
+    }
+    return 0;
+}
